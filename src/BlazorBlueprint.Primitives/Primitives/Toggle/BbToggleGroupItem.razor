@typeparam TValue
@namespace BlazorBlueprint.Primitives.Toggle
@implements IDisposable

<button @ref="elementRef"
        type="button"
        role="@Role"
        aria-checked="@(IsSingle ? IsPressed.ToString().ToLowerInvariant() : null)"
        aria-pressed="@(IsSingle ? null : IsPressed.ToString().ToLowerInvariant())"
        data-state="@(IsPressed ? "on" : "off")"
        data-orientation="@Context?.Orientation"
        disabled="@IsDisabled"
        tabindex="@TabIndex"
        @onclick="HandleClick"
        @onfocus="HandleFocus"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    private ElementReference elementRef;

    [CascadingParameter]
    private ToggleGroupContext<TValue>? Context { get; set; }

    /// <summary>
    /// Gets or sets the value associated with this toggle item.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// Gets or sets whether this item is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the child content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets additional attributes.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsDisabled => Disabled || (Context?.Disabled ?? false);

    private bool IsPressed
    {
        get
        {
            if (Value == null || Context == null)
            {
                return false;
            }

            if (Context.Type == ToggleGroupType.Single)
            {
                return EqualityComparer<TValue>.Default.Equals(Context.Value, Value);
            }
            else
            {
                return Context.Values.Contains(Value);
            }
        }
    }

    /// <summary>Whether the group this item belongs to allows only one selection.</summary>
    private bool IsSingle => Context?.Type == ToggleGroupType.Single;

    /// <summary>
    /// The ARIA role for this item, and with it the state attribute that goes alongside.
    /// </summary>
    /// <remarks>
    /// <c>aria-pressed</c> belongs to <c>role="button"</c> and <c>aria-checked</c> to
    /// <c>role="radio"</c>. Single mode rendered the radio role with the button's state attribute,
    /// which is not a combination screen readers report — the item announced as a radio whose
    /// selected state was simply absent.
    /// </remarks>
    private string Role => IsSingle ? "radio" : "button";

    private int TabIndex
    {
        get
        {
            if (IsDisabled)
            {
                return -1;
            }

            if (Context?.Type == ToggleGroupType.Single)
            {
                // Roving tabindex: only the pressed item (or first) is tabbable
                if (IsPressed)
                {
                    return 0;
                }

                var hasPressed = Context.Value != null;
                if (!hasPressed && Context.Items.Count > 0 && Context.Items[0] == this)
                {
                    return 0;
                }

                return -1;
            }

            return 0;
        }
    }

    protected override void OnInitialized()
    {
        Context?.Items.Add(this);
    }

    /// <summary>
    /// Tells the group which item actually holds focus.
    /// </summary>
    /// <remarks>
    /// The group used to track only the item its own arrow handling last focused, so after the
    /// user clicked or tabbed to a different item the next arrow key moved from the stale one and
    /// focus jumped somewhere unrelated.
    /// </remarks>
    private void HandleFocus() => Context?.ItemFocused?.Invoke(this);

    private async Task HandleClick()
    {
        if (IsDisabled || Value == null || Context?.ToggleItem == null)
        {
            return;
        }

        await Context.ToggleItem(Value);
    }

    internal async Task FocusAsync()
    {
        try
        {
            await elementRef.FocusAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException)
        {
            // Expected during circuit disconnect
        }
    }

    /// <summary>
    /// Removes this item from its group.
    /// </summary>
    /// <remarks>
    /// The component declared this method but never <c>IDisposable</c>, so Blazor never called it.
    /// Items removed from the markup stayed in the group's list forever, and arrow-key navigation
    /// kept walking onto buttons that were no longer on the page.
    /// </remarks>
    public void Dispose()
    {
        Context?.Items.Remove(this);
        GC.SuppressFinalize(this);
    }
}

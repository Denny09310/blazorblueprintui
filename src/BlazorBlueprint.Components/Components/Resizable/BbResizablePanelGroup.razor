@namespace BlazorBlueprint.Components
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_groupRef" class="@CssClass" style="@MergedStyle" @attributes="@InlineStyleMerge.WithoutStyle(AdditionalAttributes)">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>
    /// The panels to display.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The direction of the panels.
    /// </summary>
    [Parameter]
    public ResizableDirection Direction { get; set; } = ResizableDirection.Horizontal;

    /// <summary>
    /// Additional CSS classes to apply.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Invoked when a resize drag completes, carrying the resulting panel sizes.
    /// </summary>
    /// <remarks>
    /// Fires once per drag, on release, and only when the sizes actually changed — pressing a
    /// handle and releasing it without moving is not a resize. It deliberately does not fire per
    /// frame: the drag is applied in the browser precisely so that it costs no round trips, and a
    /// per-frame callback would reintroduce that cost.
    /// </remarks>
    [Parameter]
    public EventCallback<PanelResizeEventArgs> OnResizeEnd { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _groupRef;
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<BbResizablePanelGroup>? _dotNetRef;
    private string _groupId = Guid.NewGuid().ToString("N");
    private bool _jsInitialized;
    private bool _disposed;

    private List<double> _panelSizes = new();
    private List<double> _panelDefaultSizes = new();
    private List<double> _panelMinSizes = new();
    private List<double> _panelMaxSizes = new();
    private List<bool> _panelCollapsible = new();
    private int _panelCount = 0;
    private int _handleCount = 0;

    internal ResizableDirection GetDirection() => Direction;

    /// <summary>
    /// Identifies this group to the JS drag handler. Panels render it so the handler can resolve
    /// its own panel elements without picking up those of a nested group.
    /// </summary>
    internal string GroupId => _groupId;

    internal int RegisterPanel(double defaultSize, double minSize, double maxSize, bool collapsible = false)
    {
        var index = _panelCount++;
        _panelDefaultSizes.Add(defaultSize);
        _panelMinSizes.Add(minSize);
        _panelMaxSizes.Add(maxSize);
        _panelCollapsible.Add(collapsible);

        if (_panelSizes.Count <= index)
        {
            _panelSizes.Add(defaultSize);
        }

        return index;
    }

    internal double GetPanelSize(int index)
    {
        if (index >= 0 && index < _panelSizes.Count)
        {
            return _panelSizes[index];
        }
        return index < _panelDefaultSizes.Count ? _panelDefaultSizes[index] : 50;
    }

    internal int RegisterHandle()
    {
        return _handleCount++;
    }

    /// <summary>The element id given to the panel at <paramref name="index"/>.</summary>
    /// <remarks>
    /// A handle points <c>aria-controls</c> at the panel in front of it, so assistive technology can
    /// say what the separator resizes.
    /// </remarks>
    internal string PanelElementId(int index) => $"{_groupId}-panel-{index}";

    /// <summary>The smallest size the panel at <paramref name="index"/> may take, as a percentage.</summary>
    /// <remarks>Zero for a collapsible panel: it is allowed all the way shut.</remarks>
    internal double GetPanelMinSize(int index) =>
        index >= 0 && index < _panelMinSizes.Count
            ? (IsPanelCollapsible(index) ? 0 : _panelMinSizes[index])
            : 0;

    /// <summary>The largest size the panel at <paramref name="index"/> may take, as a percentage.</summary>
    internal double GetPanelMaxSize(int index) =>
        index >= 0 && index < _panelMaxSizes.Count ? _panelMaxSizes[index] : 100;

    /// <summary>Whether the panel at <paramref name="index"/> may be dragged shut.</summary>
    internal bool IsPanelCollapsible(int index) =>
        index >= 0 && index < _panelCollapsible.Count && _panelCollapsible[index];

    /// <summary>
    /// Moves a handle by <paramref name="deltaPercent"/>, taking the space from the panel on the
    /// other side of it. This is how keyboard resizing works: it never touches the browser, so the
    /// component state is authoritative and the change is committed immediately.
    /// </summary>
    /// <remarks>
    /// Clamps to what both neighbours can satisfy — the same bounds the drag loop uses — so a key
    /// press that would overshoot pins at the limit instead of being dropped. A collapsible panel
    /// taken below half its declared minimum snaps shut, matching the pointer behaviour.
    /// </remarks>
    internal async Task NudgeAsync(int handleIndex, double deltaPercent)
    {
        if (handleIndex < 0 || handleIndex + 1 >= _panelSizes.Count)
        {
            return;
        }

        var first = handleIndex;
        var second = handleIndex + 1;
        var startFirst = _panelSizes[first];
        var startSecond = _panelSizes[second];

        var lower = Math.Max(GetPanelMinSize(first) - startFirst, startSecond - GetPanelMaxSize(second));
        var upper = Math.Min(GetPanelMaxSize(first) - startFirst, startSecond - GetPanelMinSize(second));

        if (lower > upper)
        {
            return;
        }

        var delta = Math.Clamp(deltaPercent, lower, upper);
        var sizeFirst = SnapCollapse(first, Math.Round(startFirst + delta, 2));
        var sizeSecond = Math.Round(startFirst + startSecond - sizeFirst, 2);

        if (Math.Abs(sizeFirst - startFirst) < 0.001)
        {
            return;
        }

        _panelSizes[first] = sizeFirst;
        _panelSizes[second] = sizeSecond;
        StateHasChanged();

        if (OnResizeEnd.HasDelegate)
        {
            await OnResizeEnd.InvokeAsync(new PanelResizeEventArgs { Sizes = _panelSizes.ToArray() });
        }
    }

    /// <summary>
    /// Mirrors the drag loop's collapse snap: below half the declared minimum a collapsible panel
    /// goes to zero, and anything between zero and that minimum opens back out to it.
    /// </summary>
    private double SnapCollapse(int index, double size)
    {
        if (!IsPanelCollapsible(index))
        {
            return size;
        }

        var min = index < _panelMinSizes.Count ? _panelMinSizes[index] : 0;

        if (!(min > 0) || size >= min)
        {
            return size;
        }

        return size < min / 2 ? 0 : min;
    }

    internal async Task StartResize(int handleIndex, double clientX, double clientY, long pointerId)
    {
        if (_jsModule != null && _jsInitialized)
        {
            var isHorizontal = Direction == ResizableDirection.Horizontal;
            await _jsModule.InvokeVoidAsync("startResize", _groupId, handleIndex, clientX, clientY, _panelSizes.ToArray(), pointerId, _panelMinSizes.ToArray(), _panelMaxSizes.ToArray(), isHorizontal, _panelCollapsible.ToArray());
        }
    }

    /// <summary>
    /// Applies sizes reported mid-drag. Only the fallback path uses this: the drag normally writes
    /// flex-basis directly in JS, because a round trip per pointermove is unusable on Blazor
    /// Server, and component state is intentionally stale until <see cref="CommitPanelSizes"/>.
    /// </summary>
    [JSInvokable]
    public void UpdatePanelSizes(double[] newSizes)
    {
        if (_disposed) return;

        // Input validation
        if (newSizes == null || newSizes.Length == 0)
            return;

        // Reject excessively large arrays (potential DoS)
        if (newSizes.Length > 100)
            return;

        for (int i = 0; i < newSizes.Length && i < _panelSizes.Count; i++)
        {
            // Skip invalid values
            if (double.IsNaN(newSizes[i]) || double.IsInfinity(newSizes[i]))
                continue;

            // Apply min/max constraints. A collapsed panel is a legitimate zero, so a collapsible
            // panel's floor is zero rather than its MinSize.
            var floor = i < _panelCollapsible.Count && _panelCollapsible[i] && newSizes[i] <= 0
                ? 0
                : _panelMinSizes[i];
            var size = Math.Max(floor, Math.Min(_panelMaxSizes[i], newSizes[i]));
            _panelSizes[i] = size;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Commits the sizes a completed drag produced and raises <see cref="OnResizeEnd"/>. This is
    /// the single interop call of an ordinary drag; JS only invokes it when the sizes changed.
    /// </summary>
    [JSInvokable]
    public async Task CommitPanelSizes(double[] newSizes)
    {
        if (_disposed) return;

        UpdatePanelSizes(newSizes);

        if (OnResizeEnd.HasDelegate)
        {
            // Report the clamped sizes the component actually rendered, not what JS proposed.
            await OnResizeEnd.InvokeAsync(new PanelResizeEventArgs { Sizes = _panelSizes.ToArray() });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJsAsync();
        }
    }

    private async Task InitializeJsAsync()
    {
        if (_jsInitialized) return;

        try
        {
            _jsModule = await JsModules.GetAsync(JS, "./_content/BlazorBlueprint.Components/js/resizable.js");
            _dotNetRef = DotNetObjectReference.Create(this);

            var isHorizontal = Direction == ResizableDirection.Horizontal;
            await _jsModule.InvokeVoidAsync("initializeResizable", _groupRef, _dotNetRef, _groupId, isHorizontal);
            _jsInitialized = true;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // Expected during circuit disconnect in Blazor Server
        }
        catch (InvalidOperationException)
        {
            // JS interop not available during prerendering
        }
    }

    /// <summary>
    /// The group's own flex layout followed by the consumer's style, so a supplied <c>style</c>
    /// adds to it rather than replacing it.
    /// </summary>
    /// <remarks>
    /// The splat used to overwrite <c>display: flex</c> and the direction, which stops the panels
    /// laying out at all.
    /// </remarks>
    private string? MergedStyle => InlineStyleMerge.Merge(Style, AdditionalAttributes);

    private string Style => Direction == ResizableDirection.Horizontal
        ? "display: flex; flex-direction: row; height: 100%; width: 100%;"
        : "display: flex; flex-direction: column; height: 100%; width: 100%;";

    private string CssClass => ClassNames.cn(
        "bb:overflow-hidden",
        Class
    );

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_jsModule != null && _jsInitialized)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("disposeResizable", _groupId);
            }
            catch
            {
                // Cleanup may already be disposed
            }

            try
            {
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
                // Expected during circuit disconnect
            }
        }
        _dotNetRef?.Dispose();
    }
}

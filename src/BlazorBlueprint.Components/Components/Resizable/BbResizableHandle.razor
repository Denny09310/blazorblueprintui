@namespace BlazorBlueprint.Components
@using System.Globalization
@inject IBbLocalizer Localizer

<div class="@CssClass"
     role="separator"
     tabindex="0"
     aria-orientation="@(IsHorizontal ? "vertical" : "horizontal")"
     aria-label="@(AriaLabel ?? Localizer["Resizable.ResizeHandle"])"
     aria-controls="@PrimaryPanelId"
     aria-valuenow="@AriaValue(Group?.GetPanelSize(_handleIndex))"
     aria-valuemin="@AriaValue(Group?.GetPanelMinSize(_handleIndex))"
     aria-valuemax="@AriaValue(Group?.GetPanelMaxSize(_handleIndex))"
     @onpointerdown="HandlePointerDown"
     @onkeydown="HandleKeyDown"
     @onkeydown:preventDefault="_preventKeyDefault"
     @onkeyup="HandleKeyUp"
     @attributes="AdditionalAttributes">
    @if (WithHandle)
    {
        <div class="@HandleIconClass">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5.5 4.625C6.12132 4.625 6.625 4.12132 6.625 3.5C6.625 2.87868 6.12132 2.375 5.5 2.375C4.87868 2.375 4.375 2.87868 4.375 3.5C4.375 4.12132 4.87868 4.625 5.5 4.625ZM9.5 4.625C10.1213 4.625 10.625 4.12132 10.625 3.5C10.625 2.87868 10.1213 2.375 9.5 2.375C8.87868 2.375 8.375 2.87868 8.375 3.5C8.375 4.12132 8.87868 4.625 9.5 4.625ZM10.625 7.5C10.625 8.12132 10.1213 8.625 9.5 8.625C8.87868 8.625 8.375 8.12132 8.375 7.5C8.375 6.87868 8.87868 6.375 9.5 6.375C10.1213 6.375 10.625 6.87868 10.625 7.5ZM5.5 8.625C6.12132 8.625 6.625 8.12132 6.625 7.5C6.625 6.87868 6.12132 6.375 5.5 6.375C4.87868 6.375 4.375 6.87868 4.375 7.5C4.375 8.12132 4.87868 8.625 5.5 8.625ZM10.625 11.5C10.625 12.1213 10.1213 12.625 9.5 12.625C8.87868 12.625 8.375 12.1213 8.375 11.5C8.375 10.8787 8.87868 10.375 9.5 10.375C10.1213 10.375 10.625 10.8787 10.625 11.5ZM5.5 12.625C6.12132 12.625 6.625 12.1213 6.625 11.5C6.625 10.8787 6.12132 10.375 5.5 10.375C4.87868 10.375 4.375 10.8787 4.375 11.5C4.375 12.1213 4.87868 12.625 5.5 12.625Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path>
            </svg>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private BbResizablePanelGroup? Group { get; set; }

    /// <summary>
    /// Whether to show the grip handle icon.
    /// </summary>
    [Parameter]
    public bool WithHandle { get; set; } = true;

    /// <summary>
    /// Additional CSS classes to apply.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>How far one arrow key moves the handle, as a percentage of the group.</summary>
    private const double ArrowStep = 5;

    /// <summary>How far Page Up / Page Down move it.</summary>
    private const double PageStep = 20;

    private int _handleIndex = -1;
    private bool _preventKeyDefault;

    /// <summary>
    /// An accessible name for the separator. Defaults to the localized
    /// <c>Resizable.ResizeHandle</c> string.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    private bool IsHorizontal => Group?.GetDirection() == ResizableDirection.Horizontal;

    /// <summary>
    /// The panel this separator sizes — the one in front of it. Named through
    /// <c>aria-controls</c> so the value the separator reports has something to belong to.
    /// </summary>
    private string? PrimaryPanelId => Group is not null && _handleIndex >= 0
        ? Group.PanelElementId(_handleIndex)
        : null;

    /// <summary>
    /// Formats a percentage for an <c>aria-value*</c> attribute, or returns null so the attribute is
    /// omitted before the panels have registered.
    /// </summary>
    private static string? AriaValue(double? percentage) =>
        percentage?.ToString("0.##", CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        if (Group != null)
        {
            _handleIndex = Group.RegisterHandle();
        }
    }

    private async Task HandlePointerDown(PointerEventArgs e)
    {
        if (Group != null && _handleIndex >= 0)
        {
            await Group.StartResize(_handleIndex, e.ClientX, e.ClientY, e.PointerId);
        }
    }

    /// <summary>
    /// Keyboard resizing: the arrows move the handle a step at a time, Page Up/Down move it further,
    /// and Home/End take the panel to its smallest and largest.
    /// </summary>
    /// <remarks>
    /// The handle used to be a plain <c>div</c> with only a pointer handler — no role, no tab stop
    /// and no keys — while the documentation described all three. A pointer is the one input that
    /// cannot be assumed, so resizing was unreachable for anyone using a keyboard.
    /// </remarks>
    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (Group is null || _handleIndex < 0)
        {
            return;
        }

        // Which arrows act depends on which way the panels are laid out: a side-by-side group grows
        // its first panel with Right, a stacked one with Down.
        var grow = IsHorizontal ? "ArrowRight" : "ArrowDown";
        var shrink = IsHorizontal ? "ArrowLeft" : "ArrowUp";

        double delta;

        if (args.Key == grow)
        {
            delta = ArrowStep;
        }
        else if (args.Key == shrink)
        {
            delta = -ArrowStep;
        }
        else if (args.Key == "PageUp")
        {
            delta = PageStep;
        }
        else if (args.Key == "PageDown")
        {
            delta = -PageStep;
        }
        else if (args.Key is "Home" or "End")
        {
            // Far enough to reach either limit; NudgeAsync clamps to what the neighbours allow.
            delta = args.Key == "Home" ? -100 : 100;
        }
        else
        {
            // Everything else, Tab included, keeps its default action.
            _preventKeyDefault = false;
            return;
        }

        _preventKeyDefault = true;
        await Group.NudgeAsync(_handleIndex, delta);
    }

    /// <summary>
    /// Releases the suppression as soon as the key is let go.
    /// </summary>
    /// <remarks>
    /// Blazor evaluates <c>@onkeydown:preventDefault</c> when the element renders, not when the
    /// event fires, so the flag always describes the previous keystroke. Left set, the Tab that
    /// follows a resize would be swallowed and focus could never leave the handle.
    /// </remarks>
    private void HandleKeyUp() => _preventKeyDefault = false;

    private string CssClass => ClassNames.cn(
        "bb:relative bb:flex bb:items-center bb:justify-center bb:bg-border",
        // The handle is in the tab order now, so it needs a visible focus indicator.
        "bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-1 bb:focus-visible:z-10",
        IsHorizontal
            ? "bb:w-px bb:cursor-col-resize bb:hover:bg-primary/50 bb:active:bg-primary"
            : "bb:h-px bb:cursor-row-resize bb:hover:bg-primary/50 bb:active:bg-primary",
        "bb:after:absolute",
        IsHorizontal
            ? "bb:after:inset-y-0 bb:after:left-1/2 bb:after:w-1 bb:after:-translate-x-1/2"
            : "bb:after:inset-x-0 bb:after:top-1/2 bb:after:h-1 bb:after:-translate-y-1/2",
        Class
    );

    private string HandleIconClass => ClassNames.cn(
        "bb:z-10 bb:flex bb:h-4 bb:w-3 bb:items-center bb:justify-center bb:rounded-sm bb:border bb:bg-border",
        IsHorizontal ? "bb:rotate-90" : ""
    );
}

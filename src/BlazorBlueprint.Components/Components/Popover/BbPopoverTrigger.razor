@namespace BlazorBlueprint.Components

@* Styled PopoverTrigger wrapper - just passes through to primitive *@

@* In AsChild mode the primitive renders no element, so the trigger's own styling has nowhere to
   go. Only what the page set is handed down, so the development warning names that and nothing
   else. *@
<BlazorBlueprint.Primitives.Popover.BbPopoverTrigger AsChild="@AsChild"
                                                   OnClick="@OnClick"
                                                   CustomClickHandling="@CustomClickHandling"
                                                   class="@(AsChild ? null : "bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-2")"
                                                   @attributes="AdditionalAttributes">
    @ChildContent
</BlazorBlueprint.Primitives.Popover.BbPopoverTrigger>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// When true, the trigger does not render its own button element.
    /// Instead, it passes trigger behavior via TriggerContext to child components.
    /// Use this when you want a custom component (like Button) to act as the trigger.
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; } = true;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public bool CustomClickHandling { get; set; } = false;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

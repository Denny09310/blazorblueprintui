@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Primitives.Utilities
@inject IServiceProvider Services

@*
    Drawer close - closes the drawer when activated.

    Renders a real <button> by default so that it is reachable by keyboard and exposed as a
    control to assistive technology. Before #507 this was a bare <div @onclick>: it worked when
    the child happened to be focusable, and silently did not when it was not.

    Set AsChild="true" when the child is already a control — a BbButton, say — so that the child
    becomes the trigger instead of being nested inside a second button, which is invalid HTML.
    This is the same shape BbDialogTrigger, BbSheetTrigger and BbPopoverTrigger use.
*@
@if (AsChild)
{
    <CascadingValue Value="TriggerContext" Name="TriggerContext">
        @ChildContent
    </CascadingValue>
}
else
{
    <button type="button" class="@CssClass" @onclick="HandleClick" @attributes="AdditionalAttributes">
        @ChildContent
    </button>
}

@code {
    [CascadingParameter]
    public BbDrawer? Context { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// When true, does not render its own button. The child becomes the trigger and receives a
    /// cascading <see cref="TriggerContext"/>, which is what a nested control such as
    /// <c>BbButton</c> consumes.
    /// </summary>
    /// <remarks>
    /// Use this whenever the child is already a control. Leaving it false around a control nests
    /// a button inside a button, which no browser renders reliably. The child has to read the
    /// context, though: text, an icon or a plain <c>button</c> cannot, and then nothing can
    /// close the drawer and <c>Class</c> goes nowhere. The Development environment logs a warning
    /// when that happens.
    /// </remarks>
    [Parameter]
    public bool AsChild { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // #459: the browser's own outline otherwise, once this became focusable at all.
    private string? CssClass => ClassNames.cn(
        "bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-2",
        Class);

    private static readonly AsChildTriggerDescription Diagnostic = new("BbDrawerClose", "close this drawer", "<button>");

    // The context the last render cascaded, kept so the first after-render can ask whether
    // anything read it.
    private TriggerContext? lastTriggerContext;

    private TriggerContext TriggerContext => lastTriggerContext = new()
    {
        IsOpen = Context?.IsOpen ?? false,
        Close = () => _ = Context?.SetOpen(false),
    };

    private async Task HandleClick()
    {
        if (Context != null)
        {
            await Context.SetOpen(false);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            AsChildDiagnostics.WarnIfUnconsumed<BbDrawerClose>(Services, Diagnostic, AsChild, lastTriggerContext, PageAttributes());
        }
    }

    // What the page set that AsChild mode has no element for: the extra attributes, and Class,
    // which is a parameter here rather than one of them.
    private IReadOnlyDictionary<string, object>? PageAttributes() =>
        string.IsNullOrEmpty(Class)
            ? AdditionalAttributes
            : new Dictionary<string, object>(AdditionalAttributes ?? new Dictionary<string, object>()) { ["class"] = Class };
}

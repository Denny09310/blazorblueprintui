@namespace BlazorBlueprint.Components

@*
    Alert Dialog Trigger - opens the alert dialog when clicked.
    Wraps the Dialog primitive trigger.
*@

@* In AsChild mode the primitive renders no element, so the trigger's own styling has nowhere to
   go. Only what the page set is handed down, so the development warning names that and nothing
   else. *@
<BlazorBlueprint.Primitives.AlertDialog.BbAlertDialogTrigger AsChild="@AsChild"
    class="@(AsChild ? null : "bb:focus-visible:outline-none bb:focus-visible:ring-2 bb:focus-visible:ring-ring bb:focus-visible:ring-offset-2")"
    @attributes="AdditionalAttributes">
    @ChildContent
</BlazorBlueprint.Primitives.AlertDialog.BbAlertDialogTrigger>

@code {
    /// <summary>
    /// The content to render as the trigger.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// When true, the trigger will not render a default button wrapper.
    /// Instead, the child component receives trigger behavior via cascading context.
    /// </summary>
    [Parameter]
    public bool AsChild { get; set; } = true;

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

@namespace BlazorBlueprint.Components
@inject IJSRuntime JS

<CascadingValue Value="this" IsFixed="true">
    <div id="@mapId"
         style="@Style"
         @attributes="InlineStyleMerge.WithoutStyle(AdditionalAttributes)">
        @if (jsInitialized)
        {
            @ChildContent
        }
        else if (LoadingContent is not null)
        {
            @LoadingContent
        }
        else
        {
            <div class="bb:absolute bb:inset-0 bb:flex bb:items-center bb:justify-center bb:gap-2 bb:text-sm bb:text-muted-foreground">
                <svg class="bb:size-4 bb:animate-spin" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="bb:opacity-25" />
                    <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
                </svg>
                <span>Loading map&hellip;</span>
            </div>
        }
    </div>
</CascadingValue>
@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components
@inject IBbLocalizer Localizer
@implements IDisposable

<div class="bb:pointer-events-none bb:absolute @PositionClass bb:z-20" @onclick:stopPropagation="true">
    <div class="bb:pointer-events-auto bb:flex @OrientationClass bb:items-center bb:gap-1">
        <BbButtonGroup Orientation="@GroupOrientation" AriaLabel="@Localizer["MapLibre.Toolbar.ZoomControls"]">
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.IconSmall"
                      AriaLabel="@Localizer["MapLibre.Toolbar.ZoomIn"]"
                      AdditionalAttributes='Title(Localizer["MapLibre.Toolbar.ZoomIn"])'
                      OnClick="OnZoomInAsync">
                <LucideIcon Name="zoom-in" Class="bb:h-4 bb:w-4" />
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline"
                      Size="ButtonSize.IconSmall"
                      AriaLabel="@Localizer["MapLibre.Toolbar.ZoomOut"]"
                      AdditionalAttributes='Title(Localizer["MapLibre.Toolbar.ZoomOut"])'
                      OnClick="OnZoomOutAsync">
                <LucideIcon Name="zoom-out" Class="bb:h-4 bb:w-4" />
            </BbButton>
        </BbButtonGroup>

        <BbButton Variant="ButtonVariant.Outline"
                  Size="ButtonSize.IconSmall"
                  AriaLabel="@Localizer["MapLibre.Toolbar.ResetNorth"]"
                  AdditionalAttributes='Title(Localizer["MapLibre.Toolbar.ResetNorth"])'
                  OnClick="OnResetNorthAsync">
            <LucideIcon Name="compass" Class="bb:h-4 bb:w-4" />
        </BbButton>

        <BbButton Variant="ButtonVariant.Outline"
                  Size="ButtonSize.IconSmall"
                  AriaLabel="@Localizer["MapLibre.Toolbar.LocateMe"]"
                  AdditionalAttributes='Title(Localizer["MapLibre.Toolbar.LocateMe"])'
                  OnClick="OnLocateUserAsync">
            <LucideIcon Name="locate-fixed" Class="bb:h-4 bb:w-4" />
        </BbButton>

        <BbButton Variant="ButtonVariant.Outline"
                  Size="ButtonSize.IconSmall"
                  AriaLabel="@FullScreenLabel"
                  AdditionalAttributes='Title(FullScreenLabel)'
                  OnClick="OnToggleFullscreenAsync">
            <LucideIcon Name="@FullScreenIcon" Class="bb:h-4 bb:w-4" />
        </BbButton>
    </div>
</div>

@code {
    private bool fullscreen;

    [CascadingParameter]
    private BbMapLibre? Map { get; set; }

    /// <summary>
    /// The corner of the map the toolbar is anchored to. Defaults to
    /// <see cref="BbMapLibreToolbarPosition.TopRight"/>.
    /// </summary>
    [Parameter]
    public BbMapLibreToolbarPosition Position { get; set; } = BbMapLibreToolbarPosition.TopRight;

    /// <summary>
    /// Layout direction of the buttons. Defaults to
    /// <see cref="BbMapLibreToolbarOrientation.Horizontal"/>.
    /// </summary>
    [Parameter]
    public BbMapLibreToolbarOrientation Orientation { get; set; } = BbMapLibreToolbarOrientation.Horizontal;

    private static Dictionary<string, object> Title(string label) =>
        new() { ["title"] = label };

    private string PositionClass => Position switch
    {
        BbMapLibreToolbarPosition.TopLeft => "bb:top-2 bb:start-2",
        BbMapLibreToolbarPosition.TopRight => "bb:top-2 bb:end-2",
        BbMapLibreToolbarPosition.BottomLeft => "bb:bottom-2 bb:start-2",
        // Raised above MapLibre's attribution control. At this inset the toolbar would
        // otherwise sit on top of the copyright line the attribution renders here.
        _ => "bb:bottom-10 bb:end-2",
    };

    private string OrientationClass =>
        Orientation == BbMapLibreToolbarOrientation.Vertical ? "bb:flex-col" : "bb:flex-row";

    private ButtonGroupOrientation GroupOrientation =>
        Orientation == BbMapLibreToolbarOrientation.Vertical
            ? ButtonGroupOrientation.Vertical
            : ButtonGroupOrientation.Horizontal;

    private string FullScreenIcon => fullscreen ? "minimize" : "maximize";

    private string FullScreenLabel => fullscreen
        ? Localizer["MapLibre.Toolbar.ExitFullscreen"]
        : Localizer["MapLibre.Toolbar.EnterFullscreen"];

    protected override void OnInitialized()
    {
        if (Map is not null)
        {
            Map.FullscreenChanged += HandleFullscreenChanged;
        }
    }

    private Task OnZoomInAsync() => Map?.ZoomInAsync() ?? Task.CompletedTask;

    private Task OnZoomOutAsync() => Map?.ZoomOutAsync() ?? Task.CompletedTask;

    private Task OnResetNorthAsync() => Map?.ResetNorthAsync() ?? Task.CompletedTask;

    private Task OnLocateUserAsync() => Map?.LocateUserAsync() ?? Task.CompletedTask;

    private Task OnToggleFullscreenAsync() => Map?.ToggleFullscreenAsync() ?? Task.CompletedTask;

    private void HandleFullscreenChanged(bool isFullscreen)
    {
        fullscreen = isFullscreen;
        InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (Map is not null)
        {
            Map.FullscreenChanged -= HandleFullscreenChanged;
        }

        GC.SuppressFinalize(this);
    }
}
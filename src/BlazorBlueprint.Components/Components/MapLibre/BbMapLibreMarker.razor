@namespace BlazorBlueprint.Components

<div id="@markerId"
     class="bb:absolute bb:top-0 bb:start-0 @zIndexClass"
     style="@MarkerStyle">
    <div class="bb:absolute bb:start-0 bb:top-0 bb:-ms-1.5 bb:-mt-1.5 bb:size-3 bb:rounded-full bb:cursor-pointer"
         style="@DotStyle"
         role="button"
         @onclick="TogglePopup"
         @onclick:stopPropagation="true"></div>

    @if (popupOpen && ChildContent is not null)
    {
        <div class="bb:absolute bb:bottom-full bb:start-1/2 bb:-translate-x-1/2 bb:mb-1.5 bb:min-w-40 bb:whitespace-nowrap bb:rounded-md bb:border bb:bg-popover bb:text-popover-foreground bb:px-3 bb:py-2 bb:text-sm bb:shadow-md"
             @onclick:stopPropagation="true">
            @ChildContent
        </div>
    }
</div>
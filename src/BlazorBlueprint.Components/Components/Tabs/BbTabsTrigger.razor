@namespace BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components
@implements IDisposable
@inject IBbLocalizer Localizer

@*
    Styled TabsTrigger component.
    Wraps the TabsTrigger primitive with shadcn/ui styling.

    The close affordance is a span, not a button. A role="tab" element must not contain another
    interactive element, so the pointer gets an icon with a click handler and the keyboard gets
    Delete — which the primitive raises. Two routes to the same callback, one of them valid HTML.
*@

@if (isRenaming)
{
    @* The editor replaces the tab rather than sitting inside it. A text box inside a role="tab"
       is the same nesting problem as the close button, and an input that is also a tab stop
       fights the roving tabindex the list depends on. *@
    <input @ref="renameInput"
           type="text"
           value="@renameText"
           @oninput="@(e => renameText = e.Value?.ToString() ?? string.Empty)"
           @onkeydown="HandleRenameKeyDownAsync"
           @onblur="CommitRenameAsync"
           aria-label="@Localizer["Tabs.RenameLabel", EffectiveLabel]"
           class="@RenameCssClass" />
}
else
{
    <BlazorBlueprint.Primitives.Tabs.BbTabsTrigger Value="@Value"
                                                Disabled="@Disabled"
                                                OnCloseRequested="@RequestCloseAsync"
                                                OnRenameRequested="@BeginRenameAsync"
                                                OnMoveRequested="@HandleKeyboardMoveAsync"
                                                class="@CssClass"
                                                data-tab-value="@Value"
                                                draggable="@(IsReorderable ? "true" : null)"
                                                @ondblclick="HandleDoubleClickAsync"
                                                @attributes="AdditionalAttributes">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @EffectiveLabel
        }

        @if (IsClosable && !Disabled)
        {
            <span role="presentation"
                  aria-hidden="true"
                  class="@CloseCssClass"
                  title="@Localizer["Tabs.Close"]"
                  @onclick="HandleCloseClickAsync"
                  @onclick:stopPropagation="true">
                <LucideIcon Name="x" Size="12" />
            </span>
        }
    </BlazorBlueprint.Primitives.Tabs.BbTabsTrigger>
}

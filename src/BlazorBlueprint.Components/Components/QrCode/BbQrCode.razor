@namespace BlazorBlueprint.Components
@inject IBbLocalizer Localizer

@*
    QrCode - a QR code drawn as SVG, encoded in C# with no JavaScript and no dependency.

    A QR code is an image of text that only a camera can read, so the value is also available as
    text through ShowValue and through the accessible name. Without one of those, a person using a
    screen reader has no way to reach what the code says.
*@

<div class="@RootClass" data-slot="qr-code" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <BbLabel Class="bb:mb-2 bb:block">@Label</BbLabel>
    }

    @if (encodeError is not null)
    {
        <p role="alert" class="bb:text-sm bb:text-destructive">@encodeError</p>
    }
    else if (svg is not null)
    {
        @((MarkupString)svg)

        @if (ShowValue)
        {
            <p class="bb:mt-2 bb:max-w-full bb:text-center bb:text-xs bb:break-all bb:text-muted-foreground">
                @Value
            </p>
        }
    }
</div>

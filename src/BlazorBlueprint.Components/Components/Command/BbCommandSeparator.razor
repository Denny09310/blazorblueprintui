@namespace BlazorBlueprint.Components
@implements IDisposable

<div class="@CssClass"
     style="@MergedSeparatorStyle"
     role="separator"
     aria-orientation="horizontal"
     @attributes="@InlineStyleMerge.WithoutStyle(AdditionalAttributes)">
</div>

@code {
    [CascadingParameter]
    public CommandContext? Context { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the separator.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets additional HTML attributes to apply to the root element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string? MergedSeparatorStyle => InlineStyleMerge.Merge(_isVisible ? null : "display: none", AdditionalAttributes);

    private bool _isVisible = true;

    /// <summary>
    /// Gets the computed CSS classes for the separator.
    /// </summary>
    private string CssClass => ClassNames.cn(
        "bb:-mx-1 bb:h-px bb:bg-border",
        Class
    );

    protected override void OnInitialized()
    {
        if (Context != null)
        {
            Context.OnStateChanged += HandleContextStateChanged;
        }
    }

    private void HandleContextStateChanged()
    {
        if (Context == null) return;

        // Hide separator when there are no visible items (during filtering)
        _isVisible = Context.HasVisibleItems();
        StateHasChanged();
    }

    public void Dispose()
    {
        if (Context != null)
        {
            Context.OnStateChanged -= HandleContextStateChanged;
        }
    }
}

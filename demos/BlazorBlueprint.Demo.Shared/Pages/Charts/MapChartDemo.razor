@page "/charts/map"

<PageTitle>Map Chart - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">Map Chart</h1>
        <p class="text-xl text-muted-foreground">See where your audience is. Color countries by visitors, sales, or any numeric value.</p>
    </div>

    <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4 p-6">
            <div class="space-y-1.5">
                <h2 class="font-semibold leading-none tracking-tight">Visitors by country</h2>
                <p class="text-sm text-muted-foreground">@(_lastMonth ? "Last 30 days" : "Last 7 days") · Hover for visitors, click for country details</p>
            </div>
            <BbButton Variant="ButtonVariant.Outline" OnClick="TogglePeriod">@(_lastMonth ? "Show last 7 days" : "Show last 30 days")</BbButton>
        </div>
        <div class="p-6 pt-0">
            <BbMapChart Data="@Visitors" Height="420px" OnDataPointClick="SelectCountry"
                        aria-label="Website visitors by country">
                <BbChartTooltip />
                <BbMap CountryKey="Country" DataKey="Visitors" Name="Visitors" />
            </BbMapChart>
            <p class="text-sm text-muted-foreground" role="status">@_selection</p>
        </div>
    </div>
    <CodeBlock Source="Charts/MapChart/default.txt" />

    <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
        <div class="space-y-1.5 p-6">
            <h2 class="font-semibold leading-none tracking-tight">Your colors, your scale</h2>
            <p class="text-sm text-muted-foreground">A fixed scale makes periods comparable. Drag to pan and scroll to zoom.</p>
        </div>
        <div class="p-6 pt-0">
            <BbMapChart Data="@Visitors" Height="420px" aria-label="Visitors with a custom color scale">
                <BbVisualMap Min="0" Max="50000" Colors="@_colors" />
                <BbChartTooltip />
                <BbMap CountryKey="Country" DataKey="Visitors" Name="Visitors" Roam="true" />
            </BbMapChart>
        </div>
    </div>
    <CodeBlock Source="Charts/MapChart/custom-colors.txt" />

    <div class="space-y-3">
        <h2 class="text-2xl font-semibold tracking-tight">Country data</h2>
        <p class="text-muted-foreground">Use ISO country codes such as US, GBR, or SG, or English country names. Supply one row per country. Countries without data use a muted fill; zero remains a measured value.</p>
        <table class="w-full text-sm">
            <caption class="sr-only">Website visitors in the selected period</caption>
            <thead><tr class="border-b"><th class="py-2 text-left">Country</th><th class="py-2 text-right">Visitors</th></tr></thead>
            <tbody>
                @foreach (var row in Visitors)
                {
                    <tr class="border-b"><td class="py-2">@row.Country</td><td class="py-2 text-right">@row.Visitors.ToString("N0")</td></tr>
                }
            </tbody>
        </table>
        <p class="text-sm text-muted-foreground">Made with Natural Earth. The overview map includes 241 countries and regions, excluding Antarctica; very small islands may be absent or difficult to see at world scale.</p>
    </div>
</div>

@code {
    private sealed record CountryVisitors(string Country, int Visitors);

    private bool _lastMonth;
    private string _selection = "Select a country to see its visitor count.";
    private readonly string[] _colors = ["#dbeafe", "#60a5fa", "#1d4ed8"];
    private readonly CountryVisitors[] _weekly =
    [
        new("US", 12400), new("GBR", 8200), new("Germany", 6100), new("FR", 4700),
        new("IN", 9300), new("JP", 5600), new("SG", 3100), new("AU", 4200),
        new("BR", 3800), new("CA", 5100), new("ZA", 1700), new("CN", 7600)
    ];

    private CountryVisitors[] Visitors => _lastMonth
        ? _weekly.Select(row => row with { Visitors = row.Visitors * 4 }).ToArray()
        : _weekly;

    private void TogglePeriod()
    {
        _lastMonth = !_lastMonth;
        _selection = "Select a country to see its visitor count.";
    }

    private void SelectCountry(ChartClickEventArgs args)
    {
        _selection = args.Value is { } visitors
            ? $"{args.Name}: {visitors:N0} visitors (dataset row {args.DataIndex + 1})."
            : $"{args.Name}: no visitor data.";
    }
}

@page "/charts/sankey"
@using BlazorBlueprint.Icons.Lucide.Components

<PageTitle>Sankey Chart - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-6xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">Sankey Chart</h1>
            <p class="text-xl text-muted-foreground">
                Shows how a quantity splits and recombines as it moves between stages.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">Sankey Chart</h3>
                    <p class="text-sm text-muted-foreground">Where the traffic goes</p>
                </div>
                <div class="p-6 pt-0">
                    <BbSankeyChart Data="@_flows" Height="320px">
                        <BbChartTooltip />
                        <BbSankey SourceKey="from" TargetKey="to" DataKey="value" />
                    </BbSankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        One row per link, nodes derived
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        Hover a node to trace the path it belongs to
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/default.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">Vertical</h3>
                    <p class="text-sm text-muted-foreground">Flow runs down</p>
                </div>
                <div class="p-6 pt-0">
                    <BbSankeyChart Data="@_flows" Height="320px">
                        <BbChartTooltip />
                        <BbSankey SourceKey="from" TargetKey="to" DataKey="value"
                                  Orientation="SankeyOrientation.Vertical"
                                  LabelPosition="LabelPosition.Bottom" />
                    </BbSankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        SankeyOrientation.Vertical
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        Move the labels as well, or they sit over the ribbons
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/vertical.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">Link Colour</h3>
                    <p class="text-sm text-muted-foreground">Coloured by source</p>
                </div>
                <div class="p-6 pt-0">
                    <BbSankeyChart Data="@_flows" Height="320px">
                        <BbChartTooltip />
                        <BbSankey SourceKey="from" TargetKey="to" DataKey="value"
                                  LinkColor="SankeyLinkColor.Source" LinkOpacity="0.6" />
                    </BbSankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        SankeyLinkColor.Source
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        Follows one origin all the way across
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/link-color.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">Node Alignment</h3>
                    <p class="text-sm text-muted-foreground">Pulled to the left</p>
                </div>
                <div class="p-6 pt-0">
                    <BbSankeyChart Data="@_flows" Height="320px">
                        <BbChartTooltip />
                        <BbSankey SourceKey="from" TargetKey="to" DataKey="value"
                                  NodeAlign="SankeyNodeAlign.Left" />
                    </BbSankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        SankeyNodeAlign.Left
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        A terminal node sits at its own depth, not at the far edge
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/node-align.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">Straight Ribbons</h3>
                    <p class="text-sm text-muted-foreground">Narrow nodes, no bow</p>
                </div>
                <div class="p-6 pt-0">
                    <BbSankeyChart Data="@_flows" Height="320px">
                        <BbChartTooltip />
                        <BbSankey SourceKey="from" TargetKey="to" DataKey="value"
                                  Curveness="0" NodeWidth="12" NodeGap="16" />
                    </BbSankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        Curveness set to 0
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        NodeWidth and NodeGap shape the columns
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/straight.txt" />
        </div>

        <div>
            <div class="rounded-xl border bg-card text-card-foreground shadow-sm">
                <div class="flex flex-col space-y-1.5 p-6">
                    <h3 class="font-semibold leading-none tracking-tight">Draggable Nodes</h3>
                    <p class="text-sm text-muted-foreground">Rearrange by hand</p>
                </div>
                <div class="p-6 pt-0">
                    <BbSankeyChart Data="@_flows" Height="320px">
                        <BbChartTooltip />
                        <BbSankey SourceKey="from" TargetKey="to" DataKey="value" Draggable="true" />
                    </BbSankeyChart>
                </div>
                <div class="flex flex-col gap-2 p-6 pt-0">
                    <div class="flex gap-2 items-center font-medium leading-none">
                        Off by default
                    </div>
                    <div class="text-sm text-muted-foreground leading-none">
                        A dragged node stays put until the page reloads
                    </div>
                </div>
            </div>
            <CodeBlock Source="Charts/SankeyChart/draggable.txt" />
        </div>
    </div>

    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Binding the data</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-3">
            <p class="text-sm text-muted-foreground">
                Bind a collection of <strong>links</strong>, not of nodes. Each row gives a source name, a target
                name and a value, and the node list is derived from the names in the order they are first seen —
                which is also the order they take their colours from the chart palette.
            </p>
            <p class="text-sm text-muted-foreground">
                A sankey is a directed acyclic graph. ECharts throws rather than drawing when the links form a
                cycle, which leaves the whole chart blank, so a link that would close a cycle — including a link
                from a node to itself — is dropped and the rest of the diagram is drawn. A row missing either
                name, or carrying a value that is not a number, is dropped for the same reason.
            </p>
        </div>
    </div>

    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
        </div>
        <div class="border rounded-lg p-6 space-y-4">
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.SourceKey / Sankey.TargetKey</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">string?</code> (default: <code class="text-xs bg-muted px-1 py-0.5 rounded">null</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    The properties holding the name of the node each link leaves and enters. Pair them with
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">DataKey</code>, which holds the value that flows along the link.
                </p>
            </div>
            <BbSeparator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.Orientation</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">SankeyOrientation</code> (default: <code class="text-xs bg-muted px-1 py-0.5 rounded">Horizontal</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    The direction the diagram flows in. Options: Horizontal, Vertical.
                </p>
            </div>
            <BbSeparator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.NodeAlign</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">SankeyNodeAlign</code> (default: <code class="text-xs bg-muted px-1 py-0.5 rounded">Justify</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    Where the nodes with no outgoing link are placed. Options: Justify, Left, Right. The values name
                    a physical side because ECharts computes the layout and does not mirror it under
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">dir="rtl"</code>.
                </p>
            </div>
            <BbSeparator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.NodeWidth / Sankey.NodeGap</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">int</code> (defaults: <code class="text-xs bg-muted px-1 py-0.5 rounded">20</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">8</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    The thickness of a node, and the gap between two nodes in the same column, in pixels.
                </p>
            </div>
            <BbSeparator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.LinkColor</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">SankeyLinkColor</code> (default: <code class="text-xs bg-muted px-1 py-0.5 rounded">Gradient</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    How the ribbons are coloured. Options: Gradient, Source, Target.
                </p>
            </div>
            <BbSeparator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.LinkOpacity / Sankey.Curveness</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">double</code> (defaults: <code class="text-xs bg-muted px-1 py-0.5 rounded">0.4</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">0.5</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    The opacity of the ribbons, and how much they bow between their two nodes. Both run from 0 to 1.
                </p>
            </div>
            <BbSeparator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.Draggable</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (default: <code class="text-xs bg-muted px-1 py-0.5 rounded">false</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    Whether a visitor can drag a node to a new position. Off by default, unlike ECharts itself:
                    a dragged node stays where it was dropped with no way back short of a reload.
                </p>
            </div>
            <BbSeparator />
            <div>
                <h3 class="font-mono text-sm font-semibold mb-2">Sankey.FocusAdjacent</h3>
                <p class="text-sm text-muted-foreground mb-2">
                    Type: <code class="text-xs bg-muted px-1 py-0.5 rounded">bool</code> (default: <code class="text-xs bg-muted px-1 py-0.5 rounded">true</code>)
                </p>
                <p class="text-sm text-muted-foreground">
                    Whether hovering a node dims everything it is not connected to.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    public class FlowData
    {
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public int Value { get; set; }
    }

    private readonly List<FlowData> _flows =
    [
        new() { From = "Search", To = "Landing", Value = 4200 },
        new() { From = "Social", To = "Landing", Value = 1800 },
        new() { From = "Email", To = "Landing", Value = 900 },
        new() { From = "Search", To = "Blog", Value = 1600 },
        new() { From = "Social", To = "Blog", Value = 1100 },
        new() { From = "Landing", To = "Pricing", Value = 3100 },
        new() { From = "Landing", To = "Bounced", Value = 3800 },
        new() { From = "Blog", To = "Pricing", Value = 800 },
        new() { From = "Blog", To = "Bounced", Value = 1900 },
        new() { From = "Pricing", To = "Signed up", Value = 1400 },
        new() { From = "Pricing", To = "Bounced", Value = 2500 }
    ];
}

@page "/"
@using BlazorBlueprint.Icons.Lucide.Components
@inject ThemeService Theme
@implements IDisposable

<PageTitle>Blazor Blueprint 4</PageTitle>

<div class="max-w-5xl space-y-14">

    @* ── Hero ─────────────────────────────────────────────────────────── *@
    <header class="space-y-5">
        <div class="flex items-baseline gap-3">
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Blazor Blueprint</h1>
            <span class="rounded-full border border-primary/40 bg-primary/10 px-2.5 py-0.5 text-sm font-semibold text-primary">4</span>
        </div>
        <p class="max-w-[62ch] text-xl leading-relaxed text-muted-foreground">
            The shadcn/ui design system, built for Blazor. @ComponentCatalog.Items.Count components on a
            headless primitive layer, running on .NET 10 across Server, WebAssembly and Auto.
        </p>
        <div class="flex flex-wrap gap-3 pt-1">
            <BbButton Variant="ButtonVariant.Default" Href="/components">Explore components</BbButton>
            <BbButton Variant="ButtonVariant.Outline" Href="/primitives">Explore primitives</BbButton>
            <BbButton Variant="ButtonVariant.Ghost" Href="https://blazorblueprintui.com?utm_source=demo" Target="_blank">
                blazorblueprintui.com
                <LucideIcon Name="external-link" Class="ml-1 h-4 w-4" />
            </BbButton>
        </div>
    </header>

    @* ── The live board ───────────────────────────────────────────────────
       The one loud thing on the page. Every control in the strip writes to the
       real ThemeService, so it re-skins the board, the sidebar and the page
       around it — which is the fastest honest way to show what v4's theming
       actually does. ────────────────────────────────────────────────────── *@
    <section class="space-y-3">
        <div class="overflow-hidden rounded-xl border bg-card shadow-sm">

            <div class="space-y-3 border-b bg-muted/40 px-5 py-4">
                <p class="text-sm font-medium">Change the theme here. The whole page follows.</p>

                @* Each group carries its own label, so the row can wrap at any width and still say
                   what it does. *@
                <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-muted-foreground">Accent</span>
                        <div class="flex items-center gap-1.5">
                            @foreach (var (label, swatch, color) in accents)
                            {
                                <button type="button"
                                        title="@label"
                                        aria-label="@label"
                                        aria-pressed="@((Theme.PrimaryColor == color).ToString().ToLowerInvariant())"
                                        class="@SwatchClass(Theme.PrimaryColor == color)"
                                        style="background-color: @swatch;"
                                        @onclick="@(() => Theme.SetPrimaryColorAsync(color))"></button>
                            }
                        </div>
                    </div>

                    <div class="flex items-center gap-2" role="group" aria-label="Corners">
                        <span class="text-xs text-muted-foreground">Corners</span>
                        <div class="flex items-center gap-1">
                            @foreach (var (label, value) in radii)
                            {
                                <button type="button"
                                        class="@ChoiceClass(Math.Abs(Theme.Radius - value) < 0.001)"
                                        aria-pressed="@((Math.Abs(Theme.Radius - value) < 0.001).ToString().ToLowerInvariant())"
                                        @onclick="@(() => Theme.SetRadiusAsync(value))">@label</button>
                            }
                        </div>
                    </div>

                    <div class="flex items-center gap-2" role="group" aria-label="Density">
                        <span class="text-xs text-muted-foreground">Density</span>
                        <div class="flex items-center gap-1">
                            @foreach (var (label, value) in densities)
                            {
                                <button type="button"
                                        class="@ChoiceClass(Theme.Preset.Design.Density == value)"
                                        aria-pressed="@((Theme.Preset.Design.Density == value).ToString().ToLowerInvariant())"
                                        @onclick="@(() => Theme.SetDesignAsync(Theme.Preset.Design with { Density = value }))">@label</button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid gap-x-10 gap-y-7 p-5 sm:p-6 md:grid-cols-2">
                <div class="space-y-3">
                    <p class="text-sm font-medium">Actions</p>
                    <div class="flex flex-wrap items-center gap-2">
                        <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small">Publish</BbButton>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small">Preview</BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small">Discard</BbButton>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 pt-1">
                        <BbBadge Variant="BadgeVariant.Default">Live</BbBadge>
                        <BbBadge Variant="BadgeVariant.Secondary">Draft</BbBadge>
                        <BbBadge Variant="BadgeVariant.Outline">Archived</BbBadge>
                    </div>
                </div>

                <div class="space-y-3">
                    <p class="text-sm font-medium">Release name</p>
                    <BbInput Value="@releaseName" ValueChanged="@(v => releaseName = v)" Placeholder="Name this release" />
                    <div class="flex items-center gap-3">
                        <BbSwitch Id="board-notify" Checked="@notify" CheckedChanged="@(v => notify = v)" />
                        <label for="board-notify" class="text-sm text-muted-foreground">Notify the team on publish</label>
                    </div>
                </div>

                <div class="space-y-3">
                    <p class="text-sm font-medium">Audience</p>
                    <BbToggleGroup TValue="string" Value="@audience" ValueChanged="@(v => audience = v ?? audience)" Required="true" Class="justify-start">
                        <BbToggleGroupItem TValue="string" Value="@("everyone")">Everyone</BbToggleGroupItem>
                        <BbToggleGroupItem TValue="string" Value="@("beta")">Beta</BbToggleGroupItem>
                        <BbToggleGroupItem TValue="string" Value="@("internal")">Internal</BbToggleGroupItem>
                    </BbToggleGroup>
                </div>

                <div class="space-y-3">
                    <div class="flex items-baseline justify-between">
                        <p class="text-sm font-medium">Rollout</p>
                        <span class="text-sm tabular-nums text-muted-foreground">@rollout%</span>
                    </div>
                    <BbSlider Value="@rollout" ValueChanged="@(v => rollout = v)" Min="0" Max="100" Step="5" />
                </div>
            </div>
        </div>

        <p class="text-sm text-muted-foreground">
            Base colour, accent, radius, density, font, surface and menu styling all persist per visitor.
            The header's <a href="/components/theme" class="underline underline-offset-4 hover:text-foreground">theme switcher</a> exposes the rest.
        </p>
    </section>

    @* ── What's new ───────────────────────────────────────────────────────
       A list, not a card grid: these are peers, and rules say so without
       pretending each one is a separate object. ───────────────────────── *@
    <section class="space-y-5">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-2xl font-semibold tracking-tight">New in 4</h2>
            <p class="text-sm text-muted-foreground">
                @ComponentCatalog.Items.Count(i => i.IsNew) additions since 3.17
            </p>
        </div>

        <ul class="divide-y border-y">
            @foreach (var item in whatsNew)
            {
                <li>
                    <a href="@item.Url"
                       class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
                        <span class="w-48 shrink-0 font-medium group-hover:text-primary">@item.Title</span>
                        <span class="text-sm leading-relaxed text-muted-foreground">@item.Summary</span>
                    </a>
                </li>
            }
        </ul>
    </section>

    @* ── Two layers ──────────────────────────────────────────────────────── *@
    <section class="space-y-5">
        <h2 class="text-2xl font-semibold tracking-tight">Two layers, one design system</h2>
        <div class="grid gap-6 md:grid-cols-2">
            <div class="space-y-2">
                <h3 class="font-semibold">Primitives</h3>
                <p class="text-sm leading-relaxed text-muted-foreground">
                    Behaviour, keyboard handling, focus management and ARIA, with no styling at all.
                    Build your own design system on top and keep full control of the markup.
                </p>
                <a href="/primitives" class="inline-block text-sm text-primary hover:underline">Explore primitives</a>
            </div>
            <div class="space-y-2">
                <h3 class="font-semibold">Components</h3>
                <p class="text-sm leading-relaxed text-muted-foreground">
                    The same primitives wearing the shadcn/ui look — the design tokens, CSS variables and
                    visual language the React ecosystem already uses. Drop them in and ship.
                </p>
                <a href="/components" class="inline-block text-sm text-primary hover:underline">Explore components</a>
            </div>
        </div>
        <p class="max-w-[68ch] text-sm leading-relaxed text-muted-foreground">
            Past shadcn/ui parity there is a second tier built for line-of-business work:
            <a href="/components/datagrid" class="underline underline-offset-4 hover:text-foreground">Data Grid</a>,
            <a href="/components/scheduler" class="underline underline-offset-4 hover:text-foreground">Scheduler</a>,
            <a href="/components/dashboard-grid" class="underline underline-offset-4 hover:text-foreground">Dashboard Grid</a>,
            <a href="/components/dynamic-form" class="underline underline-offset-4 hover:text-foreground">Dynamic Form Builder</a>,
            <a href="/components/filterbuilder" class="underline underline-offset-4 hover:text-foreground">Filter Builder</a> and
            <a href="/components/currency-input" class="underline underline-offset-4 hover:text-foreground">Currency Input</a>.
        </p>
    </section>

    @* ── Start here ──────────────────────────────────────────────────────── *@
    <section class="space-y-4 border-t pt-8">
        <h2 class="text-2xl font-semibold tracking-tight">Start here</h2>
        <p class="max-w-[62ch] leading-relaxed text-muted-foreground">
            Every demo page carries live examples, a copyable snippet, the keyboard and ARIA behaviour,
            and a full API reference. The sidebar has all of them; press
            <BbKbd>@("Ctrl")</BbKbd> <BbKbd>@("K")</BbKbd> to jump straight to one.
        </p>
        <div class="flex flex-wrap gap-3">
            <BbButton Variant="ButtonVariant.Default" Href="/getting-started">Get started</BbButton>
            <BbButton Variant="ButtonVariant.Outline" Href="/architecture">How it fits together</BbButton>
        </div>
    </section>
</div>

@code {
    private string releaseName = "Aurora";
    private bool notify = true;
    private string audience = "beta";
    private double rollout = 45;

    private static readonly (string Label, string Swatch, PrimaryColor Color)[] accents =
    [
        ("Default", "oklch(0.552 0.016 285.94)", PrimaryColor.Default),
        ("Blue", "oklch(0.546 0.245 262.88)", PrimaryColor.Blue),
        ("Violet", "oklch(0.541 0.281 293.01)", PrimaryColor.Violet),
        ("Emerald", "oklch(0.596 0.145 163.23)", PrimaryColor.Emerald),
        ("Amber", "oklch(0.769 0.188 70.08)", PrimaryColor.Amber),
        ("Rose", "oklch(0.585 0.22 3.96)", PrimaryColor.Rose),
    ];

    private static readonly (string Label, double Value)[] radii =
    [
        ("Square", 0),
        ("Soft", 0.5),
        ("Round", 1.0),
    ];

    private static readonly (string Label, ThemeDensity Value)[] densities =
    [
        ("Compact", ThemeDensity.Compact),
        ("Standard", ThemeDensity.Standard),
        ("Spacious", ThemeDensity.Spacious),
    ];

    private static readonly (string Title, string Summary, string Url)[] whatsNew =
    [
        ("Scheduler", "Day, week and work-week views with resource lanes, drag and resize, recurrence, and independent event and display time zones.", "/components/scheduler"),
        ("Grid editing", "Edit a cell at a time or stage a whole batch. Drafts are isolated, validated before saving, and kept when persistence rejects them.", "/components/datagrid-editing"),
        ("Theme presets", "Density, font, surface and menu styling alongside colour and radius — the controls you just used, saved per visitor.", "/components/theme"),
        ("Hierarchy pickers", "Tree Select and Cascader: searchable hierarchies with stable keys, cascading checkboxes and full-path search.", "/components/tree-select"),
        ("Mobile components", "App Bar, Bottom Navigation, Quantity Stepper, Notification Badge, and Drawer snap points with pointer and keyboard resizing.", "/components/app-bar"),
        ("Motion", "Presets and custom keyframes, height animation, page and screen transitions. Reduced motion is honoured throughout.", "/components/motion"),
        ("File upload lifecycle", "Stream to your own destination with progress, cancellation and retry, from a size-limited browser stream.", "/components/file-upload"),
        ("Keyboard sortables", "Pick up, reorder, transfer between connected lists and cancel — all without a pointer.", "/components/sortable"),
    ];

    /// <summary>
    /// The accent swatches double as the selected-state indicator, so the ring has to read on a
    /// coloured fill in both light and dark mode.
    /// </summary>
    private static string SwatchClass(bool selected) => string.Join(' ',
        "h-6 w-6 rounded-full border transition-[box-shadow,transform] motion-reduce:transition-none",
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
        selected
            ? "border-foreground ring-2 ring-foreground ring-offset-2 ring-offset-background"
            : "border-black/10 hover:scale-110 dark:border-white/20");

    private static string ChoiceClass(bool selected) => string.Join(' ',
        "rounded-md border px-2.5 py-1 text-xs font-medium transition-colors motion-reduce:transition-none",
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
        selected
            ? "border-foreground bg-accent text-accent-foreground"
            : "border-input text-muted-foreground hover:bg-accent/50 hover:text-foreground");

    protected override void OnInitialized() => Theme.OnThemeChanged += HandleThemeChanged;

    private void HandleThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.OnThemeChanged -= HandleThemeChanged;
}

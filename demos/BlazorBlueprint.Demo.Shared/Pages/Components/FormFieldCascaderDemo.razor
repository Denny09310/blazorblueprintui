@page "/components/form-field-cascader"
@using System.ComponentModel.DataAnnotations

<PageTitle>FormFieldCascader Component - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">FormFieldCascader</h1>
        <p class="text-xl text-muted-foreground">
            A form field wrapper for Cascader with built-in label, helper text, and error messages.
        </p>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Usage</h2>
            <p class="text-sm text-muted-foreground">
                Each level opens a new column. Search matches the full path.
            </p>
        </div>
        <div class="max-w-md">
            <BbFormFieldCascader TItem="Category"
                                 @bind-Value="_selected"
                                 Label="Category"
                                 HelperText="Navigate the columns, or search the full path."
                                 Items="_categories"
                                 ValueField="@(c => c.Id)"
                                 TextField="@(c => c.Name)"
                                 ChildrenProperty="@(c => c.Children)" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">Value:</p>
            <p class="text-sm font-mono">@(_selected ?? "(none)")</p>
        </div>
        <CodeBlock Source="Components/FormFieldCascader/basic.txt" />
    </div>

    <!-- Branches -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Selectable Branches</h2>
            <p class="text-sm text-muted-foreground">
                <code class="text-xs bg-muted px-1 py-0.5 rounded">ChangeOnSelect</code> lets a branch be the answer
                while its children stay navigable.
            </p>
        </div>
        <div class="max-w-md">
            <BbFormFieldCascader TItem="Category"
                                 @bind-Value="_branch"
                                 Label="Region"
                                 HelperText="A department is enough; a team is more precise."
                                 ChangeOnSelect="true"
                                 Items="_categories"
                                 ValueField="@(c => c.Id)"
                                 TextField="@(c => c.Name)"
                                 ChildrenProperty="@(c => c.Children)" />
        </div>
        <CodeBlock Source="Components/FormFieldCascader/branches.txt" />
    </div>

    <!-- Validation -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Validation</h2>
            <p class="text-sm text-muted-foreground">
                Validation errors display automatically inside an EditForm. Submit with nothing chosen to see one.
            </p>
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <BbFormFieldCascader TItem="Category"
                                         @bind-Value="_formModel.CategoryId"
                                         Label="Category"
                                         HelperText="Required."
                                         Required="true"
                                         Items="_categories"
                                         ValueField="@(c => c.Id)"
                                         TextField="@(c => c.Name)"
                                         ChildrenProperty="@(c => c.Children)" />
                    <BbButton Type="ButtonType.Submit">Submit</BbButton>
                </div>
            </EditForm>
            @if (_formSubmitted)
            {
                <div class="mt-4 rounded-lg border border-green-200 bg-green-50 dark:bg-green-950 dark:border-green-800 p-4">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">
                        Submitted: @_formModel.CategoryId
                    </p>
                </div>
            }
        </div>
        <CodeBlock Source="Components/FormFieldCascader/editform.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Disabled</h2>
            <p class="text-sm text-muted-foreground">A disabled cascader form field.</p>
        </div>
        <div class="max-w-md">
            <BbFormFieldCascader TItem="Category"
                                 Value="@("runtime")"
                                 Label="Category"
                                 HelperText="Set by your account's billing address."
                                 Disabled="true"
                                 Items="_categories"
                                 ValueField="@(c => c.Id)"
                                 TextField="@(c => c.Name)"
                                 ChildrenProperty="@(c => c.Children)" />
        </div>
        <CodeBlock Source="Components/FormFieldCascader/disabled.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>Label associated with the trigger through <code class="text-xs bg-muted px-1 py-0.5 rounded">for</code></AccessibilityItem>
            <AccessibilityItem>Helper and error text linked with <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-describedby</code></AccessibilityItem>
            <AccessibilityItem>Trigger reports <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-required</code>; each column is a labelled group</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="Move between enabled form controls"><BbKbd>Tab</BbKbd> / <BbKbd>Shift + Tab</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Open the columns"><BbKbd>Enter</BbKbd> / <BbKbd>Space</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Move within a column"><BbKbd>ArrowUp</BbKbd> / <BbKbd>ArrowDown</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Move between columns"><BbKbd>ArrowRight</BbKbd> / <BbKbd>ArrowLeft</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Close without choosing"><BbKbd>Escape</BbKbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
            <p class="text-muted-foreground">Component properties and parameters.</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="FormFieldCascader&lt;TItem&gt;">
                <ApiParameter Name="TItem" Type="Type">The type of an item in the hierarchy.</ApiParameter>
                <ApiParameter Name="Label" Type="string?" Default="null">The label text.</ApiParameter>
                <ApiParameter Name="HelperText" Type="string?" Default="null">Helper text below the control.</ApiParameter>
                <ApiParameter Name="ErrorText" Type="string?" Default="null">Manual error text override.</ApiParameter>
                <ApiParameter Name="Items" Type="IEnumerable&lt;TItem&gt;">The root items of the hierarchy.</ApiParameter>
                <ApiParameter Name="ValueField" Type="Func&lt;TItem, string&gt;">Selector for an item's unique key.</ApiParameter>
                <ApiParameter Name="TextField" Type="Func&lt;TItem, string&gt;">Selector for an item's display text.</ApiParameter>
                <ApiParameter Name="ChildrenProperty" Type="Func&lt;TItem, IEnumerable&lt;TItem&gt;?&gt;">Selector for an item's children.</ApiParameter>
                <ApiParameter Name="Value" Type="string?" Default="null">The selected node's key. Use @@bind-Value.</ApiParameter>
                <ApiParameter Name="ValueChanged" Type="EventCallback&lt;string?&gt;">Callback when the selection changes.</ApiParameter>
                <ApiParameter Name="ChangeOnSelect" Type="bool" Default="false">Allow selecting a branch while its children stay navigable.</ApiParameter>
                <ApiParameter Name="ShowSearch" Type="bool" Default="true">Show the full-path search box.</ApiParameter>
                <ApiParameter Name="Clearable" Type="bool" Default="true">Show a clear button.</ApiParameter>
                <ApiParameter Name="Placeholder" Type="string?" Default="null">Shown when nothing is selected.</ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">Whether the control is disabled.</ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">Whether the field is required.</ApiParameter>
                <ApiParameter Name="Orientation" Type="FieldOrientation" Default="Vertical">Label placement relative to the control.</ApiParameter>
                <ApiParameter Name="InputClass" Type="string?" Default="null">CSS classes for the inner cascader.</ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
</div>

@code {
    private string? _selected = "runtime";
    private string? _branch = "engineering";
    private readonly FormModel _formModel = new();
    private bool _formSubmitted;

    private readonly List<Category> _categories =
    [
        new("engineering", "Engineering", [new("platform", "Platform", [new("runtime", "Runtime", []), new("tools", "Tools", [])]), new("web", "Web", [])]),
        new("design", "Design", [new("product", "Product", []), new("brand", "Brand", [])])
    ];

    private void HandleFormSubmit() => _formSubmitted = true;

    private sealed record Category(string Id, string Name, List<Category> Children);

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Choose a category.")]
        public string? CategoryId { get; set; }
    }
}

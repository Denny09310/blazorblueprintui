@page "/components/form-field-time-input"
@using System.ComponentModel.DataAnnotations

<PageTitle>FormFieldTimeInput Component - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">FormFieldTimeInput</h1>
        <p class="text-xl text-muted-foreground">
            A form field wrapper for TimeInput with built-in label, helper text, and error messages.
        </p>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Usage</h2>
            <p class="text-sm text-muted-foreground">
                Hours and minutes are separate segments, on your culture's 12- or 24-hour clock.
            </p>
        </div>
        <div class="max-w-md">
            <BbFormFieldTimeInput @bind-Value="_startTime"
                                  Label="Start time"
                                  HelperText="Type each part, or use the arrow keys." />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">Value:</p>
            <p class="text-sm font-mono">@(_startTime?.ToString(@"hh\:mm") ?? "(none)")</p>
        </div>
        <CodeBlock Source="Components/FormFieldTimeInput/basic.txt" />
    </div>

    <!-- Format -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Format and Steps</h2>
            <p class="text-sm text-muted-foreground">
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Format</code> overrides the culture's clock.
                <code class="text-xs bg-muted px-1 py-0.5 rounded">MinuteStep</code> sets the minute increment, and
                <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowPicker</code> adds a clock button.
            </p>
        </div>
        <div class="max-w-md">
            <BbFormFieldTimeInput @bind-Value="_shiftStart"
                                  Label="Shift start"
                                  HelperText="Quarter-hour steps."
                                  Format="TimeFormat.Hour24"
                                  MinuteStep="15"
                                  ShowPicker="true" />
        </div>
        <CodeBlock Source="Components/FormFieldTimeInput/format.txt" />
    </div>

    <!-- Validation -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Validation</h2>
            <p class="text-sm text-muted-foreground">
                Validation errors display automatically inside an EditForm. Submit with the field empty to see one.
            </p>
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <BbFormFieldTimeInput @bind-Value="_formModel.StartTime"
                                          Label="Start time"
                                          HelperText="Required." />
                    <BbButton Type="ButtonType.Submit">Submit</BbButton>
                </div>
            </EditForm>
            @if (_formSubmitted)
            {
                <div class="mt-4 rounded-lg border border-green-200 bg-green-50 dark:bg-green-950 dark:border-green-800 p-4">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">
                        Submitted: @_formModel.StartTime?.ToString(@"hh\:mm")
                    </p>
                </div>
            }
        </div>
        <CodeBlock Source="Components/FormFieldTimeInput/editform.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Disabled</h2>
            <p class="text-sm text-muted-foreground">A disabled time input form field.</p>
        </div>
        <div class="max-w-md">
            <BbFormFieldTimeInput Value="_openingTime"
                                  Label="Opening time"
                                  HelperText="Set by the store's schedule."
                                  Disabled="true" />
        </div>
        <CodeBlock Source="Components/FormFieldTimeInput/disabled.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>Label associated with the first segment through <code class="text-xs bg-muted px-1 py-0.5 rounded">for</code></AccessibilityItem>
            <AccessibilityItem>Helper and error text linked with <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-describedby</code></AccessibilityItem>
            <AccessibilityItem>Each segment is a <code class="text-xs bg-muted px-1 py-0.5 rounded">spinbutton</code> reporting its own value and bounds</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="Move between enabled form controls"><BbKbd>Tab</BbKbd> / <BbKbd>Shift + Tab</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Move between segments"><BbKbd>ArrowLeft</BbKbd> / <BbKbd>ArrowRight</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Increase or decrease the focused segment"><BbKbd>ArrowUp</BbKbd> / <BbKbd>ArrowDown</BbKbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
            <p class="text-muted-foreground">Component properties and parameters.</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="FormFieldTimeInput">
                <ApiParameter Name="Label" Type="string?" Default="null">The label text.</ApiParameter>
                <ApiParameter Name="HelperText" Type="string?" Default="null">Helper text below the input.</ApiParameter>
                <ApiParameter Name="ErrorText" Type="string?" Default="null">Manual error text override.</ApiParameter>
                <ApiParameter Name="Value" Type="TimeSpan?" Default="null">The selected time. Use @@bind-Value.</ApiParameter>
                <ApiParameter Name="ValueChanged" Type="EventCallback&lt;TimeSpan?&gt;">Callback when the time changes.</ApiParameter>
                <ApiParameter Name="Culture" Type="CultureInfo?" Default="null">Separators and the 12/24-hour default. Defaults to the current culture.</ApiParameter>
                <ApiParameter Name="Format" Type="TimeFormat?" Default="null">Overrides the culture's 12- or 24-hour clock.</ApiParameter>
                <ApiParameter Name="MinTime" Type="TimeSpan?" Default="null">Earliest selectable time, inclusive.</ApiParameter>
                <ApiParameter Name="MaxTime" Type="TimeSpan?" Default="null">Latest selectable time, inclusive.</ApiParameter>
                <ApiParameter Name="MinuteStep" Type="int" Default="1">The increment the minute segment steps by.</ApiParameter>
                <ApiParameter Name="ShowSeconds" Type="bool" Default="false">Show a seconds segment.</ApiParameter>
                <ApiParameter Name="ShowPicker" Type="bool" Default="false">Show a clock picker button.</ApiParameter>
                <ApiParameter Name="ReadOnly" Type="bool" Default="false">Whether the segments are read-only.</ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">Whether the input is disabled.</ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">Whether the field is required.</ApiParameter>
                <ApiParameter Name="Orientation" Type="FieldOrientation" Default="Vertical">Label placement relative to the control.</ApiParameter>
                <ApiParameter Name="InputClass" Type="string?" Default="null">CSS classes for the inner time input.</ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
</div>

@code {
    private TimeSpan? _startTime;
    private TimeSpan? _shiftStart = new(9, 0, 0);
    private readonly TimeSpan _openingTime = new(9, 0, 0);
    private readonly FormModel _formModel = new();
    private bool _formSubmitted;

    private void HandleFormSubmit() => _formSubmitted = true;

    private sealed class FormModel
    {
        [Required(ErrorMessage = "A start time is required.")]
        public TimeSpan? StartTime { get; set; }
    }
}

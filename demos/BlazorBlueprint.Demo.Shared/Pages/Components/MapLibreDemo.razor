@page "/components/maplibre"
<PageTitle>MapLibre - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">MapLibre</h1>
            <p class="text-xl text-muted-foreground">
                Vector maps powered by MapLibre GL JS, hosted inside a Blazor container. The map
                itself is drawn by the engine; everything on top of it &mdash; the
                <strong>BbMapLibreMarker</strong> pins, their popups, tooltips, labels and dragging
                &mdash; is Blazor.
            </p>
            <p class="text-muted-foreground">
                Pins stay ordinary children of the map container, so Blazor keeps ownership of
                their markup. The interop layer moves them around with CSS transforms as the camera
                moves and hands drag events back to .NET through <code>OnMoved</code>. Routes, by
                contrast, are drawn natively by the engine as line layers, so they pan, zoom and
                clip with the map automatically.
            </p>
        </div>
    </div>

    <div class="space-y-6">
        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">Basic Usage</h2>
                <p class="text-muted-foreground">
                    Place a <code class="text-xs bg-muted px-1 py-0.5 rounded">BbMapLibreMarker</code>
                    with <code class="text-xs bg-muted px-1 py-0.5 rounded">Latitude</code> and
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Longitude</code>. Without
                    content the marker renders its default pin.
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 space-y-3">
                <BbMapLibre Style="height: 400px; width: 100%;" />
            </div>

            <CodeBlock Source="Components/MapLibre/basic.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">Markers</h2>
                <p class="text-muted-foreground">
                    Place a <code class="text-xs bg-muted px-1 py-0.5 rounded">BbMapLibreMarker</code>
                    inside the map with <code class="text-xs bg-muted px-1 py-0.5 rounded">Latitude</code>,
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Longitude</code> and an optional
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Color</code> or
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Size</code>. Markers stay ordinary
                    children of the map container while the interop layer keeps them pinned to the
                    geography with CSS transforms. Add content to a marker to show a popup card when
                    its dot is hovered. The card is kept inside the map viewport while the dot is on
                    screen &mdash; flipping to the other side of the marker near an edge &mdash; and
                    follows the dot if the marker is panned off the map. While the map loads, a
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">LoadingContent</code> fragment
                    is shown (or a built-in spinner when one is not supplied), and the markers render
                    only once the map is ready.
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 space-y-3">
                <BbMapLibre Center="new BbMapCoordinate(40.7128, -74.0060)" Zoom="11" Style="height: 400px; width: 100%;">
                    <LoadingContent>
                        <div class="flex h-full items-center justify-center gap-2 text-sm text-muted-foreground">
                            <svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25" />
                                <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
                            </svg>
                            Loading map&hellip;
                        </div>
                    </LoadingContent>
                    <ChildContent>
                        <BbMapLibreMarker Latitude="40.7128" Longitude="-74.0060">
                            <div class="font-medium">New York City</div>
                            <p class="text-xs text-muted-foreground">Lat 40.7128, Lng -74.0060</p>
                        </BbMapLibreMarker>
                        <BbMapLibreMarker Latitude="40.7580" Longitude="-73.9855" Color="var(--chart-2)">
                            <div class="font-medium">Times Square</div>
                        </BbMapLibreMarker>
                        <BbMapLibreMarker Latitude="40.6892" Longitude="-74.0445" Color="var(--destructive)" Size="24" />
                    </ChildContent>
                </BbMapLibre>
            </div>

            <CodeBlock Source="Components/MapLibre/markers.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">Routes</h2>
                <p class="text-muted-foreground">
                    Add a <code class="text-xs bg-muted px-1 py-0.5 rounded">BbMapLibreRoute</code>
                    with an ordered list of <code class="text-xs bg-muted px-1 py-0.5 rounded">Points</code>
                    to draw a line over the map. The route is painted by the map engine as a native
                    line layer, so it pans, zooms and clips with the map &mdash; and is redrawn
                    automatically after a theme switch restyles the map. Style the line with
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Color</code>,
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Width</code> and
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Opacity</code>. Because the
                    line is painted to a canvas, <code
                    class="text-xs bg-muted px-1 py-0.5 rounded">Color</code> must be a concrete CSS
                    color &mdash; CSS variables cannot be resolved.
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 space-y-3">
                <BbMapLibre Center="new BbMapCoordinate(40.7359, -74.0013)" Zoom="12" Style="height: 400px; width: 100%;">
                    <ChildContent>
                        <BbMapLibreMarker Latitude="40.7128" Longitude="-74.0060">
                            <div class="font-medium">Start</div>
                        </BbMapLibreMarker>

                        <BbMapLibreRoute Points="routePoints" />

                        <BbMapLibreMarker Latitude="40.7580" Longitude="-73.9855" Color="var(--chart-2)">
                            <div class="font-medium">End</div>
                        </BbMapLibreMarker>
                    </ChildContent>
                </BbMapLibre>
            </div>

            <CodeBlock Source="Components/MapLibre/routes.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">Toolbar</h2>
                <p class="text-muted-foreground">
                    Drop a <code class="text-xs bg-muted px-1 py-0.5 rounded">BbMapLibreToolbar</code>
                    inside the map for floating zoom in/out, compass (reset north), GPS (locate the
                    device) and fullscreen controls. Anchor it to any corner with
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Position</code> and lay the
                    buttons out with <code class="text-xs bg-muted px-1 py-0.5 rounded">Orientation</code>.
                    Like markers, the toolbar stays an ordinary child of the map container &mdash;
                    the buttons drive the camera and the container's fullscreen through the interop
                    layer.
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 space-y-3">
                <BbMapLibre Center="new BbMapCoordinate(40.7128, -74.0060)" Zoom="11" Style="height: 400px; width: 100%;">
                    <ChildContent>
                        <BbMapLibreToolbar Position="BbMapLibreToolbarPosition.BottomRight"
                                           Orientation="BbMapLibreToolbarOrientation.Vertical" />

                        <BbMapLibreMarker Latitude="40.7128" Longitude="-74.0060">
                            <div class="font-medium">New York City</div>
                        </BbMapLibreMarker>
                    </ChildContent>
                </BbMapLibre>
            </div>

            <CodeBlock Source="Components/MapLibre/toolbar.txt" />
        </section>

        <section class="space-y-4">
            <div class="space-y-2">
                <h2 class="text-2xl font-semibold">Two-Way Binding</h2>
                <p class="text-muted-foreground">
                    Bind <code class="text-xs bg-muted px-1 py-0.5 rounded">Center</code> (latitude,
                    longitude), <code class="text-xs bg-muted px-1 py-0.5 rounded">Zoom</code> and
                    <code class="text-xs bg-muted px-1 py-0.5 rounded">Bearing</code> to drive the
                    camera from Blazor and stay in sync while the user pans, zooms and rotates.
                    Give the map a shake with the buttons below, then rotate it with a right drag.
                </p>
            </div>

            <div class="rounded-lg border bg-card p-6 space-y-3">
                <p class="text-sm text-muted-foreground">
                    Center:
                    <span class="font-mono text-foreground">
                        @($"{center.Latitude:F4}, {center.Longitude:F4}")
                    </span>
                    &middot; Zoom:
                    <span class="font-mono text-foreground">@zoom.ToString("F2")</span>
                    &middot; Bearing:
                    <span class="font-mono text-foreground">@bearing.ToString("F0")&deg;</span>
                </p>

                <div class="flex gap-2">
                    <button type="button"
                            class="rounded-md border bg-background px-3 py-1.5 text-sm text-foreground hover:bg-accent"
                            @onclick="() => bearing = (bearing + 45) % 360">
                        Rotate +45&deg;
                    </button>
                    <button type="button"
                            class="rounded-md border bg-background px-3 py-1.5 text-sm text-foreground hover:bg-accent"
                            @onclick="() => bearing = 0">
                        Reset bearing
                    </button>
                </div>

                <BbMapLibre @bind-Center="center" @bind-Zoom="zoom" @bind-Bearing="bearing" Style="height: 400px; width: 100%;" />
            </div>

            <CodeBlock Source="Components/MapLibre/controlled.txt" />
        </section>
    </div>

    <ApiReference ComponentName="BbMapLibre">
        <ApiParameter Name="Style" Type="string?">
            Inline styles for the map container &mdash; the map needs a height.
        </ApiParameter>
        <ApiParameter Name="Center" Type="BbMapCoordinate?">
            The geographic center of the map. Two-way bindable with <code
            class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-Center</code>.
        </ApiParameter>
        <ApiParameter Name="Zoom" Type="double?">
            The map zoom level. Two-way bindable with <code
            class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-Zoom</code>.
        </ApiParameter>
        <ApiParameter Name="Bearing" Type="double?">
            The map's bearing (rotation) in degrees, 0 being north. Two-way bindable with <code
            class="text-xs bg-muted px-1 py-0.5 rounded">@@bind-Bearing</code>.
        </ApiParameter>
        <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
            Additional HTML attributes applied to the map container, e.g. <code
            class="text-xs bg-muted px-1 py-0.5 rounded">AriaLabel</code>.
        </ApiParameter>
        <ApiParameter Name="LoadingContent" Type="RenderFragment?">
            Content shown inside the map container while the map is loading. When omitted a built-in
            spinner is shown. The map's child content (markers) is only rendered once the map is
            ready.
        </ApiParameter>
    </ApiReference>

    <ApiReference ComponentName="BbMapLibreMarker">
        <ApiParameter Name="Latitude" Type="double">
            The marker's latitude.
        </ApiParameter>
        <ApiParameter Name="Longitude" Type="double">
            The marker's longitude.
        </ApiParameter>
        <ApiParameter Name="Color" Type="string?">
            CSS color used for the marker dot, e.g. <code
            class="text-xs bg-muted px-1 py-0.5 rounded">var(--chart-2)</code>. Defaults to
            <code class="text-xs bg-muted px-1 py-0.5 rounded">var(--color-primary)</code>.
        </ApiParameter>
        <ApiParameter Name="Size" Type="double" Default="12">
            Diameter of the marker dot in pixels. The dot is centered on its geographic
            coordinate and the pulsing halo scales with the dot.
        </ApiParameter>
        <ApiParameter Name="ChildContent" Type="RenderFragment?">
            Optional popup content shown in a card when the dot is hovered. The card is kept
            inside the map viewport while the dot is on screen, flipping to the other side of the
            marker near an edge, and follows the dot if the marker is panned off the map. When
            omitted, the marker is a plain dot with no popup interaction.
        </ApiParameter>
    </ApiReference>

    <ApiReference ComponentName="BbMapLibreRoute">
        <ApiParameter Name="Points" Type="IReadOnlyList&lt;BbMapCoordinate&gt;">
            The geographic points of the route line, in the order they are drawn. Two or more
            points draw a polyline; passing fewer draws nothing.
        </ApiParameter>
        <ApiParameter Name="Color" Type="string">
            CSS color of the route line. Defaults to <code
            class="text-xs bg-muted px-1 py-0.5 rounded">#3b82f6</code>. Unlike DOM-rendered
            elements, canvas paints cannot resolve CSS variables, so pass a concrete color.
        </ApiParameter>
        <ApiParameter Name="Width" Type="double">
            Line width in pixels. Defaults to 3.
        </ApiParameter>
        <ApiParameter Name="Opacity" Type="double">
            Line opacity from 0 (fully transparent) to 1 (fully opaque). Defaults to 1.
        </ApiParameter>
    </ApiReference>

    <ApiReference ComponentName="BbMapLibreToolbar">
        <ApiParameter Name="Position" Type="BbMapLibreToolbarPosition">
            The corner of the map the toolbar is anchored to. Defaults to
            <code class="text-xs bg-muted px-1 py-0.5 rounded">BbMapLibreToolbarPosition.TopRight</code>.
        </ApiParameter>
        <ApiParameter Name="Orientation" Type="BbMapLibreToolbarOrientation">
            Layout direction of the buttons. Defaults to
            <code class="text-xs bg-muted px-1 py-0.5 rounded">BbMapLibreToolbarOrientation.Horizontal</code>.
        </ApiParameter>
    </ApiReference>

</div>

@code {
    private static readonly BbMapCoordinate[] routePoints =
    [
        new(40.7128, -74.0060),
        new(40.7273, -74.0014),
        new(40.7484, -73.9857),
        new(40.7580, -73.9855),
    ];

    private BbMapCoordinate center = new(40.7128, -74.0060);
    private double zoom = 10;
    private double bearing;
}
@page "/components/form-field-tree-select"
@using System.ComponentModel.DataAnnotations

<PageTitle>FormFieldTreeSelect Component - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">FormFieldTreeSelect</h1>
        <p class="text-xl text-muted-foreground">
            A form field wrapper for TreeSelect with built-in label, helper text, and error messages.
        </p>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Usage</h2>
            <p class="text-sm text-muted-foreground">
                Single selection binds <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code>.
            </p>
        </div>
        <div class="max-w-md">
            <BbFormFieldTreeSelect TItem="Category"
                                   @bind-Value="_selected"
                                   Label="Department"
                                   HelperText="Search, or expand a branch to pick a team."
                                   Items="_categories"
                                   ValueField="@(c => c.Id)"
                                   TextField="@(c => c.Name)"
                                   ChildrenProperty="@(c => c.Children)" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">Value:</p>
            <p class="text-sm font-mono">@(_selected ?? "(none)")</p>
        </div>
        <CodeBlock Source="Components/FormFieldTreeSelect/basic.txt" />
    </div>

    <!-- Multiple -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Multiple Selection</h2>
            <p class="text-sm text-muted-foreground">
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Multiple</code> binds
                <code class="text-xs bg-muted px-1 py-0.5 rounded">Values</code> instead, and ticking a parent
                cascades to its children.
            </p>
        </div>
        <div class="max-w-md">
            <BbFormFieldTreeSelect TItem="Category"
                                   @bind-Values="_selectedMany"
                                   Label="Teams"
                                   HelperText="Pick one or more teams."
                                   Multiple="true"
                                   LeafOnly="true"
                                   Items="_categories"
                                   ValueField="@(c => c.Id)"
                                   TextField="@(c => c.Name)"
                                   ChildrenProperty="@(c => c.Children)" />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">Values:</p>
            <p class="text-sm font-mono">@(_selectedMany.Count > 0 ? string.Join(", ", _selectedMany) : "(none)")</p>
        </div>
        <CodeBlock Source="Components/FormFieldTreeSelect/multiple.txt" />
    </div>

    <!-- Validation -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Validation</h2>
            <p class="text-sm text-muted-foreground">
                Bind the expression that matches the mode you are in: <code class="text-xs bg-muted px-1 py-0.5 rounded">Value</code>
                for single selection, <code class="text-xs bg-muted px-1 py-0.5 rounded">Values</code> for multiple.
                The validation message follows it. Submit with nothing chosen to see one.
            </p>
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <BbFormFieldTreeSelect TItem="Category"
                                           @bind-Value="_formModel.DepartmentId"
                                           Label="Department"
                                           HelperText="Required."
                                           Required="true"
                                           Items="_categories"
                                           ValueField="@(c => c.Id)"
                                           TextField="@(c => c.Name)"
                                           ChildrenProperty="@(c => c.Children)" />
                    <BbButton Type="ButtonType.Submit">Submit</BbButton>
                </div>
            </EditForm>
            @if (_formSubmitted)
            {
                <div class="mt-4 rounded-lg border border-green-200 bg-green-50 dark:bg-green-950 dark:border-green-800 p-4">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">
                        Submitted: @_formModel.DepartmentId
                    </p>
                </div>
            }
        </div>
        <CodeBlock Source="Components/FormFieldTreeSelect/editform.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Disabled</h2>
            <p class="text-sm text-muted-foreground">A disabled tree select form field.</p>
        </div>
        <div class="max-w-md">
            <BbFormFieldTreeSelect TItem="Category"
                                   Value="@("runtime")"
                                   Label="Department"
                                   HelperText="Your department is set by HR."
                                   Disabled="true"
                                   Items="_categories"
                                   ValueField="@(c => c.Id)"
                                   TextField="@(c => c.Name)"
                                   ChildrenProperty="@(c => c.Children)" />
        </div>
        <CodeBlock Source="Components/FormFieldTreeSelect/disabled.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>Label associated with the trigger through <code class="text-xs bg-muted px-1 py-0.5 rounded">for</code></AccessibilityItem>
            <AccessibilityItem>Helper and error text linked with <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-describedby</code></AccessibilityItem>
            <AccessibilityItem>Trigger is a <code class="text-xs bg-muted px-1 py-0.5 rounded">combobox</code> reporting <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-expanded</code> and <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-required</code></AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="Move between enabled form controls"><BbKbd>Tab</BbKbd> / <BbKbd>Shift + Tab</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Open the tree"><BbKbd>Enter</BbKbd> / <BbKbd>Space</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Move between nodes"><BbKbd>ArrowUp</BbKbd> / <BbKbd>ArrowDown</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Expand or collapse a branch"><BbKbd>ArrowRight</BbKbd> / <BbKbd>ArrowLeft</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Close without choosing"><BbKbd>Escape</BbKbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
            <p class="text-muted-foreground">Component properties and parameters.</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="FormFieldTreeSelect&lt;TItem&gt;">
                <ApiParameter Name="TItem" Type="Type">The type of an item in the hierarchy.</ApiParameter>
                <ApiParameter Name="Label" Type="string?" Default="null">The label text.</ApiParameter>
                <ApiParameter Name="HelperText" Type="string?" Default="null">Helper text below the control.</ApiParameter>
                <ApiParameter Name="ErrorText" Type="string?" Default="null">Manual error text override.</ApiParameter>
                <ApiParameter Name="Items" Type="IEnumerable&lt;TItem&gt;">The root items of the hierarchy.</ApiParameter>
                <ApiParameter Name="ValueField" Type="Func&lt;TItem, string&gt;">Selector for an item's unique key.</ApiParameter>
                <ApiParameter Name="TextField" Type="Func&lt;TItem, string&gt;">Selector for an item's display text.</ApiParameter>
                <ApiParameter Name="ChildrenProperty" Type="Func&lt;TItem, IEnumerable&lt;TItem&gt;?&gt;">Selector for an item's children.</ApiParameter>
                <ApiParameter Name="Value" Type="string?" Default="null">The selected key in single-selection mode. Use @@bind-Value.</ApiParameter>
                <ApiParameter Name="Values" Type="HashSet&lt;string&gt;" Default="empty">The selected keys in multiple mode. Use @@bind-Values.</ApiParameter>
                <ApiParameter Name="Multiple" Type="bool" Default="false">Allow more than one selection.</ApiParameter>
                <ApiParameter Name="LeafOnly" Type="bool" Default="false">Only leaf items are selectable.</ApiParameter>
                <ApiParameter Name="ShowSearch" Type="bool" Default="true">Show the search box.</ApiParameter>
                <ApiParameter Name="Clearable" Type="bool" Default="true">Show a clear button.</ApiParameter>
                <ApiParameter Name="Placeholder" Type="string?" Default="null">Shown when nothing is selected.</ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">Whether the control is disabled.</ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">Whether the field is required.</ApiParameter>
                <ApiParameter Name="Orientation" Type="FieldOrientation" Default="Vertical">Label placement relative to the control.</ApiParameter>
                <ApiParameter Name="InputClass" Type="string?" Default="null">CSS classes for the inner tree select.</ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
</div>

@code {
    private string? _selected = "runtime";
    private HashSet<string> _selectedMany = ["runtime", "brand"];
    private readonly FormModel _formModel = new();
    private bool _formSubmitted;

    private readonly List<Category> _categories =
    [
        new("engineering", "Engineering", [new("platform", "Platform", [new("runtime", "Runtime", []), new("tools", "Tools", [])]), new("web", "Web", [])]),
        new("design", "Design", [new("product", "Product", []), new("brand", "Brand", [])])
    ];

    private void HandleFormSubmit() => _formSubmitted = true;

    private sealed record Category(string Id, string Name, List<Category> Children);

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Choose a department.")]
        public string? DepartmentId { get; set; }
    }
}

@page "/components/resizable"
@using System.Globalization
<PageTitle>Resizable Component - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div>
        <div class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight">Resizable Component</h1>
            <p class="text-xl text-muted-foreground">
                Resizable panels with drag handles for adjustable layouts.
            </p>
        </div>
    </div>

    <!-- Basic Horizontal -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Horizontal Layout</h2>
            <p class="text-sm text-muted-foreground">
                Two panels side by side with a draggable handle.
            </p>
        </div>
        <div class="h-[200px] border rounded-lg overflow-hidden">
            <BbResizablePanelGroup Direction="ResizableDirection.Horizontal">
                <BbResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Panel One</span>
                    </div>
                </BbResizablePanel>
                <BbResizableHandle />
                <BbResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Panel Two</span>
                    </div>
                </BbResizablePanel>
            </BbResizablePanelGroup>
        </div>
        <CodeBlock Source="Components/Resizable/horizontal.txt" />
    </div>

    <!-- Keyboard Resizing -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Keyboard Resizing</h2>
            <p class="text-sm text-muted-foreground">
                Tab to a handle and resize without a pointer: arrows move 5%, <code>Page Up</code> and
                <code>Page Down</code> move 20%, and <code>Home</code> / <code>End</code> go to the minimum and maximum.
            </p>
        </div>
        <div class="h-[200px] border rounded-lg overflow-hidden">
            <BbResizablePanelGroup Direction="ResizableDirection.Horizontal">
                <BbResizablePanel DefaultSize="40" MinSize="20">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Navigation</span>
                    </div>
                </BbResizablePanel>
                <BbResizableHandle AriaLabel="Resize the navigation panel" />
                <BbResizablePanel DefaultSize="60">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Content</span>
                    </div>
                </BbResizablePanel>
            </BbResizablePanelGroup>
        </div>
        <CodeBlock Source="Components/Resizable/keyboard.txt" />
    </div>

    <!-- Collapsible Panel -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Collapsible Panel</h2>
            <p class="text-sm text-muted-foreground">
                Drag the handle left, past half of <code>MinSize</code>, and the sidebar snaps shut. Drag back
                and it reopens at <code>MinSize</code>.
            </p>
        </div>
        <div class="h-[200px] border rounded-lg overflow-hidden">
            <BbResizablePanelGroup Direction="ResizableDirection.Horizontal">
                <BbResizablePanel DefaultSize="25" MinSize="15" Collapsible="true">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Sidebar</span>
                    </div>
                </BbResizablePanel>
                <BbResizableHandle />
                <BbResizablePanel DefaultSize="75">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Content</span>
                    </div>
                </BbResizablePanel>
            </BbResizablePanelGroup>
        </div>
        <CodeBlock Source="Components/Resizable/collapsible.txt" />
    </div>

    <!-- Vertical Layout -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Vertical Layout</h2>
            <p class="text-sm text-muted-foreground">
                Two panels stacked vertically.
            </p>
        </div>
        <div class="h-[300px] border rounded-lg overflow-hidden">
            <BbResizablePanelGroup Direction="ResizableDirection.Vertical">
                <BbResizablePanel DefaultSize="30">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Header</span>
                    </div>
                </BbResizablePanel>
                <BbResizableHandle />
                <BbResizablePanel DefaultSize="70">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Content</span>
                    </div>
                </BbResizablePanel>
            </BbResizablePanelGroup>
        </div>
        <CodeBlock Source="Components/Resizable/vertical.txt" />
    </div>

    <!-- Without Handle Icon -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Without Handle Icon</h2>
            <p class="text-sm text-muted-foreground">
                Clean divider without the grip handle icon.
            </p>
        </div>
        <div class="h-[200px] border rounded-lg overflow-hidden">
            <BbResizablePanelGroup Direction="ResizableDirection.Horizontal">
                <BbResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6 bg-muted/50">
                        <span class="font-semibold">Left</span>
                    </div>
                </BbResizablePanel>
                <BbResizableHandle WithHandle="false" />
                <BbResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Right</span>
                    </div>
                </BbResizablePanel>
            </BbResizablePanelGroup>
        </div>
        <CodeBlock Source="Components/Resizable/without-handle-icon.txt" />
    </div>

    <!-- Three Panels -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Three Panels</h2>
            <p class="text-sm text-muted-foreground">
                Multiple panels in a single group.
            </p>
        </div>
        <div class="h-[200px] border rounded-lg overflow-hidden">
            <BbResizablePanelGroup Direction="ResizableDirection.Horizontal">
                <BbResizablePanel DefaultSize="25">
                    <div class="flex h-full items-center justify-center p-6 bg-muted/30">
                        <span class="font-semibold">Sidebar</span>
                    </div>
                </BbResizablePanel>
                <BbResizableHandle />
                <BbResizablePanel DefaultSize="50">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Main Content</span>
                    </div>
                </BbResizablePanel>
                <BbResizableHandle />
                <BbResizablePanel DefaultSize="25">
                    <div class="flex h-full items-center justify-center p-6 bg-muted/30">
                        <span class="font-semibold">Details</span>
                    </div>
                </BbResizablePanel>
            </BbResizablePanelGroup>
        </div>
        <CodeBlock Source="Components/Resizable/three-panels.txt" />
    </div>

    <!-- Nested Layout -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Nested Layout</h2>
            <p class="text-sm text-muted-foreground">
                Complex layout with nested resizable panels.
            </p>
        </div>
        <div class="h-[400px] border rounded-lg overflow-hidden">
            <BbResizablePanelGroup Direction="ResizableDirection.Horizontal">
                <BbResizablePanel DefaultSize="30">
                    <div class="flex h-full items-center justify-center p-6 bg-muted/30">
                        <span class="font-semibold">Sidebar</span>
                    </div>
                </BbResizablePanel>
                <BbResizableHandle />
                <BbResizablePanel DefaultSize="70">
                    <BbResizablePanelGroup Direction="ResizableDirection.Vertical">
                        <BbResizablePanel DefaultSize="60">
                            <div class="flex h-full items-center justify-center p-6">
                                <span class="font-semibold">Main Content</span>
                            </div>
                        </BbResizablePanel>
                        <BbResizableHandle />
                        <BbResizablePanel DefaultSize="40">
                            <div class="flex h-full items-center justify-center p-6 bg-muted/20">
                                <span class="font-semibold">Terminal / Output</span>
                            </div>
                        </BbResizablePanel>
                    </BbResizablePanelGroup>
                </BbResizablePanel>
            </BbResizablePanelGroup>
        </div>
        <CodeBlock Source="Components/Resizable/nested.txt" />
    </div>

    <!-- Reacting to a resize -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Reacting to a Resize</h2>
            <p class="text-sm text-muted-foreground">
                <code>OnResizeEnd</code> reports the resulting sizes when a drag finishes — useful for
                persisting a layout. It fires once on release rather than per frame, because the drag
                itself runs entirely in the browser and never round-trips.
            </p>
        </div>
        <div class="h-[200px] border rounded-lg overflow-hidden">
            <BbResizablePanelGroup Direction="ResizableDirection.Horizontal" OnResizeEnd="HandleResizeEnd">
                <BbResizablePanel DefaultSize="40">
                    <div class="flex h-full items-center justify-center p-6 bg-muted/30">
                        <span class="font-semibold">Left</span>
                    </div>
                </BbResizablePanel>
                <BbResizableHandle />
                <BbResizablePanel DefaultSize="60">
                    <div class="flex h-full items-center justify-center p-6">
                        <span class="font-semibold">Right</span>
                    </div>
                </BbResizablePanel>
            </BbResizablePanelGroup>
        </div>
        <p class="text-sm text-muted-foreground">
            @if (lastSizes is null)
            {
                <span>Drag the handle to see the committed sizes.</span>
            }
            else
            {
                <span>
                    Last resize: <code>@string.Join("% / ", lastSizes.Select(s => s.ToString("F2", CultureInfo.InvariantCulture)))%</code>
                    (@resizeCount @(resizeCount == 1 ? "event" : "events"))
                </span>
            }
        </p>
        <CodeBlock Source="Components/Resizable/on-resize-end.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>
                Each handle is a <code>role="separator"</code> with <code>aria-orientation</code> — <code>vertical</code>
                for side-by-side panels, <code>horizontal</code> for stacked ones.
            </AccessibilityItem>
            <AccessibilityItem>
                <code>aria-valuenow</code>, <code>aria-valuemin</code> and <code>aria-valuemax</code> report the size of
                the panel in front of the handle, as a percentage. <code>aria-controls</code> names that panel.
            </AccessibilityItem>
            <AccessibilityItem>
                Handles carry a localized <code>aria-label</code> (<code>Resizable.ResizeHandle</code>). Override it per
                handle with <code>AriaLabel</code> when one group holds several.
            </AccessibilityItem>
            <AccessibilityItem>
                Panels render their size as <code>flex-basis</code>; put your own landmark role or
                <code>aria-label</code> on a panel when its content needs one.
            </AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="Focus a resize handle">
                <BbKbd>Tab</BbKbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Resize by 5%">
                <BbKbd>Arrow Keys</BbKbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Resize by 20%">
                <BbKbd>Page Up</BbKbd> / <BbKbd>Page Down</BbKbd>
            </KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Shrink to the minimum / grow to the maximum">
                <BbKbd>Home</BbKbd> / <BbKbd>End</BbKbd>
            </KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
            <p class="text-muted-foreground">Component properties and parameters.</p>
        </div>

        <div class="space-y-4">
            <ApiReference ComponentName="ResizablePanelGroup">
                <ApiParameter Name="Direction" Type="ResizableDirection" Default="Horizontal">
                    The direction of the panels. Options: Horizontal, Vertical.
                </ApiParameter>
                <ApiParameter Name="OnResizeEnd" Type="EventCallback&lt;PanelResizeEventArgs&gt;" Default="null">
                    Invoked when a resize drag completes, carrying the resulting panel sizes as
                    percentages in declared order. Fires once on release, and only when the sizes changed.
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    Additional CSS classes for the panel group container.
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="ResizablePanel">
                <ApiParameter Name="DefaultSize" Type="double" Default="50">
                    The default size as a percentage (0-100).
                </ApiParameter>
                <ApiParameter Name="MinSize" Type="double" Default="10">
                    The minimum size as a percentage (0-100).
                </ApiParameter>
                <ApiParameter Name="MaxSize" Type="double" Default="100">
                    The maximum size as a percentage (0-100).
                </ApiParameter>
                <ApiParameter Name="Collapsible" Type="bool" Default="false">
                    Lets the panel be dragged shut. Below half of <code>MinSize</code> it snaps to zero, and it
                    reopens at <code>MinSize</code> on the way back.
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    Additional CSS classes for the panel.
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                </ApiParameter>
            </ApiReference>

            <ApiReference ComponentName="ResizableHandle">
                <ApiParameter Name="WithHandle" Type="bool" Default="true">
                    Whether to show the grip handle icon.
                </ApiParameter>
                <ApiParameter Since="v4" Name="AriaLabel" Type="string?" Default="null">
                    Accessible name for the separator. Defaults to the localized <code>Resizable.ResizeHandle</code>
                    string; set it per handle when a group holds more than one.
                </ApiParameter>
                <ApiParameter Name="Class" Type="string?" Default="null">
                    Additional CSS classes for the handle.
                </ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    Additional HTML attributes applied to the root <code>&lt;div&gt;</code> element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<double>? lastSizes;
    private int resizeCount;

    private void HandleResizeEnd(PanelResizeEventArgs args)
    {
        lastSizes = args.Sizes;
        resizeCount++;
    }
}

@page "/components/form-field-date-input"
@using System.ComponentModel.DataAnnotations

<PageTitle>FormFieldDateInput Component - Blazor Blueprint</PageTitle>

<div class="space-y-8 max-w-4xl">
    <div class="space-y-3">
        <h1 class="text-4xl font-bold tracking-tight">FormFieldDateInput</h1>
        <p class="text-xl text-muted-foreground">
            A form field wrapper for DateInput with built-in label, helper text, and error messages.
        </p>
    </div>

    <!-- Basic Example -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Basic Usage</h2>
            <p class="text-sm text-muted-foreground">
                Day, month and year are separate segments, in your culture's order.
            </p>
        </div>
        <div class="max-w-md">
            <BbFormFieldDateInput @bind-Value="_startDate"
                                  Label="Start date"
                                  HelperText="Type each part, or use the arrow keys." />
        </div>
        <div class="rounded-lg border p-4 bg-muted/50">
            <p class="text-sm font-medium mb-1">Value:</p>
            <p class="text-sm font-mono">@(_startDate?.ToString("yyyy-MM-dd") ?? "(none)")</p>
        </div>
        <CodeBlock Source="Components/FormFieldDateInput/basic.txt" />
    </div>

    <!-- Bounds -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Bounds and Calendar</h2>
            <p class="text-sm text-muted-foreground">
                <code class="text-xs bg-muted px-1 py-0.5 rounded">MinDate</code> and
                <code class="text-xs bg-muted px-1 py-0.5 rounded">MaxDate</code> are inclusive.
                <code class="text-xs bg-muted px-1 py-0.5 rounded">ShowCalendar</code> adds a picker button.
            </p>
        </div>
        <div class="max-w-md">
            <BbFormFieldDateInput @bind-Value="_bookingDate"
                                  Label="Booking date"
                                  HelperText="Within the next 30 days."
                                  MinDate="DateTime.Today"
                                  MaxDate="DateTime.Today.AddDays(30)"
                                  ShowCalendar="true" />
        </div>
        <CodeBlock Source="Components/FormFieldDateInput/bounds.txt" />
    </div>

    <!-- Validation -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Validation</h2>
            <p class="text-sm text-muted-foreground">
                Validation errors display automatically inside an EditForm. Submit with the field empty to see one.
            </p>
        </div>
        <div class="max-w-md">
            <EditForm Model="_formModel" OnValidSubmit="HandleFormSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4">
                    <BbFormFieldDateInput @bind-Value="_formModel.StartDate"
                                          Label="Start date"
                                          HelperText="Required." />
                    <BbButton Type="ButtonType.Submit">Submit</BbButton>
                </div>
            </EditForm>
            @if (_formSubmitted)
            {
                <div class="mt-4 rounded-lg border border-green-200 bg-green-50 dark:bg-green-950 dark:border-green-800 p-4">
                    <p class="text-sm font-medium text-green-800 dark:text-green-200">
                        Submitted: @_formModel.StartDate?.ToString("yyyy-MM-dd")
                    </p>
                </div>
            }
        </div>
        <CodeBlock Source="Components/FormFieldDateInput/editform.txt" />
    </div>

    <!-- Disabled -->
    <div class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">Disabled</h2>
            <p class="text-sm text-muted-foreground">A disabled date input form field.</p>
        </div>
        <div class="max-w-md">
            <BbFormFieldDateInput Value="DateTime.Today"
                                  Label="Created"
                                  HelperText="Set when the record was created."
                                  Disabled="true" />
        </div>
        <CodeBlock Source="Components/FormFieldDateInput/disabled.txt" />
    </div>

    <AccessibilityList>
        <AriaAttributes>
            <AccessibilityItem>Label associated with the first segment through <code class="text-xs bg-muted px-1 py-0.5 rounded">for</code></AccessibilityItem>
            <AccessibilityItem>Helper and error text linked with <code class="text-xs bg-muted px-1 py-0.5 rounded">aria-describedby</code></AccessibilityItem>
            <AccessibilityItem>Each segment is a <code class="text-xs bg-muted px-1 py-0.5 rounded">spinbutton</code> reporting its own value and bounds</AccessibilityItem>
        </AriaAttributes>
        <KeyboardNavigation>
            <KeyboardShortcutItem Description="Move between enabled form controls"><BbKbd>Tab</BbKbd> / <BbKbd>Shift + Tab</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Move between segments"><BbKbd>ArrowLeft</BbKbd> / <BbKbd>ArrowRight</BbKbd></KeyboardShortcutItem>
            <KeyboardShortcutItem Description="Increase or decrease the focused segment"><BbKbd>ArrowUp</BbKbd> / <BbKbd>ArrowDown</BbKbd></KeyboardShortcutItem>
        </KeyboardNavigation>
    </AccessibilityList>

    <!-- API Reference -->
    <section class="space-y-4">
        <div class="space-y-2">
            <h2 class="text-2xl font-semibold">API Reference</h2>
            <p class="text-muted-foreground">Component properties and parameters.</p>
        </div>
        <div class="space-y-4">
            <ApiReference ComponentName="FormFieldDateInput">
                <ApiParameter Name="Label" Type="string?" Default="null">The label text.</ApiParameter>
                <ApiParameter Name="HelperText" Type="string?" Default="null">Helper text below the input.</ApiParameter>
                <ApiParameter Name="ErrorText" Type="string?" Default="null">Manual error text override.</ApiParameter>
                <ApiParameter Name="Value" Type="DateTime?" Default="null">The selected date. Use @@bind-Value.</ApiParameter>
                <ApiParameter Name="ValueChanged" Type="EventCallback&lt;DateTime?&gt;">Callback when the date changes.</ApiParameter>
                <ApiParameter Name="Culture" Type="CultureInfo?" Default="null">Segment order and separators. Defaults to the current culture.</ApiParameter>
                <ApiParameter Name="MinDate" Type="DateTime?" Default="null">Earliest selectable date, inclusive.</ApiParameter>
                <ApiParameter Name="MaxDate" Type="DateTime?" Default="null">Latest selectable date, inclusive.</ApiParameter>
                <ApiParameter Name="ShowCalendar" Type="bool" Default="false">Show a calendar picker button.</ApiParameter>
                <ApiParameter Name="ReadOnly" Type="bool" Default="false">Whether the segments are read-only.</ApiParameter>
                <ApiParameter Name="Disabled" Type="bool" Default="false">Whether the input is disabled.</ApiParameter>
                <ApiParameter Name="Required" Type="bool" Default="false">Whether the field is required.</ApiParameter>
                <ApiParameter Name="Orientation" Type="FieldOrientation" Default="Vertical">Label placement relative to the control.</ApiParameter>
                <ApiParameter Name="InputClass" Type="string?" Default="null">CSS classes for the inner date input.</ApiParameter>
                <ApiParameter Name="AdditionalAttributes" Type="Dictionary&lt;string, object&gt;?">
                    Additional HTML attributes applied to the component's root element (e.g. <code>data-testid</code>, <code>aria-label</code>).
                </ApiParameter>
            </ApiReference>
        </div>
    </section>
</div>

@code {
    private DateTime? _startDate;
    private DateTime? _bookingDate;
    private readonly FormModel _formModel = new();
    private bool _formSubmitted;

    private void HandleFormSubmit() => _formSubmitted = true;

    private sealed class FormModel
    {
        [Required(ErrorMessage = "A start date is required.")]
        public DateTime? StartDate { get; set; }
    }
}

@using BlazorBlueprint.Icons.Lucide.Components

<BbButton Variant="ButtonVariant.Ghost"
          Size="ButtonSize.Icon"
          AriaLabel="@(IsRtl ? "Switch to left-to-right" : "Switch to right-to-left")"
          OnClick="Toggle">
    <LucideIcon Name="@(IsRtl ? "pilcrow-right" : "pilcrow-left")" Size="18" />
</BbButton>

@code {
    /// <summary>The current writing direction.</summary>
    [Parameter] public TextDirection Direction { get; set; } = TextDirection.LeftToRight;

    /// <summary>Raised when the toggle changes the direction.</summary>
    [Parameter] public EventCallback<TextDirection> DirectionChanged { get; set; }

    private bool IsRtl => Direction == TextDirection.RightToLeft;

    private Task Toggle() => DirectionChanged.InvokeAsync(
        IsRtl ? TextDirection.LeftToRight : TextDirection.RightToLeft);
}
